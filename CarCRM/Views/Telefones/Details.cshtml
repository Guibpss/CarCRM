@model CarCRM.ViewModels.TelefoneViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Detalhes</h1>

<div>
    <h4>Telefone</h4>
    <hr />
    <dl>
        <dt class="col-sm-2">
            Tipo
        </dt>
        <dd class="col-sm-10">
            @Model.TelefoneTipo?.Nome
        </dd>

        <dt class="col-sm-2">
            DDD
        </dt>
        <dd class="col-sm-10">
            @Model.DDD
        </dd>

        <dt class="col-sm-2">
            Número
        </dt>
        <dd class="col-sm-10">
            @Model.Numero
        </dd>

        <dt class="col-sm-2">
            Pessoa
        </dt>
        <dd class="col-sm-10">
            @Model.Pessoa?.Nome
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Voltar</a>
</div>
