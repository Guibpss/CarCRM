@model CarCRM.ViewModels.TelefoneViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3>Tem certeza que deseja excluir?</h3>
<div>
    <h4>Telefone</h4>
    <hr />
    <dl>
        <dt class="col-sm-2">
            Tipo
        </dt>
        <dd class="col-sm-10">
            @Model.TelefoneTipo?.Nome
        </dd>

        <dt class="col-sm-2">
            DDD
        </dt>
        <dd class="col-sm-10">
            @Model.DDD
        </dd>

        <dt class="col-sm-2">
            Número
        </dt>
        <dd class="col-sm-10">
            @Model.Numero
        </dd>

        <dt class="col-sm-2">
            Pessoa
        </dt>
        <dd class="col-sm-10">
            @Model.Pessoa?.Nome
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>
