@model CarCRM.ViewModels.TelefoneViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Telefone</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="form-group">
                <label class="control-label">Tipo</label>
                @Html.DropDownList("telefoneTipoId",
                        new SelectList(ViewBag.telefonesTipo, "Id", "Nome", Model.TelefoneTipoId),
                        "Selecione o Tipo",
                        new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label class="control-label">DDD</label>
                <input name="ddd" value="@Model.DDD" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Número</label>
                <input name="numero" value="@Model.Numero" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Pessoa</label>
                @Html.DropDownList("pessoaId",
                        new SelectList(ViewBag.pessoas, "Id", "Nome", Model.PessoaId),
                        "Selecione a Pessoa",
                        new { @class = "form-control" })
            </div>
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
