@model CarCRM.Models.Venda

@{
    ViewData["Title"] = "Details";
}

<h1>Detalhes</h1>

<div>
    <h4>Venda</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Data
        </dt>
        <dd class = "col-sm-10">
            @Model.DataVenda.ToString("dd/MM/yyyy")
        </dd>

        <dt class = "col-sm-2">
            Cliente
        </dt>
        <dd class = "col-sm-10">
            @Model.Cliente?.Pessoa?.Nome
        </dd>

        <dt class="col-sm-2">
            Vendedor
        </dt>
        <dd class="col-sm-10">
            @Model.Vendedor?.Nome
        </dd>

        <dt class = "col-sm-2">
            Status
        </dt>
        <dd class = "col-sm-10">
            @Model.StatusVenda?.Nome
        </dd>

        <dt class = "col-sm-2">
            Valor da Venda
        </dt>
        <dd class = "col-sm-10">
            @Model.ValorVenda.ToString("C")
        </dd>

        <dt class="col-sm-2">
            Desconto
        </dt>
        <dd class="col-sm-10">
            @Model.Desconto.ToString("C")
        </dd>

        <dt class="col-sm-2">
            Valor Final
        </dt>
        <dd class="col-sm-10">
            @Model.ValorFinal.ToString("C")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Voltar</a>
</div>
