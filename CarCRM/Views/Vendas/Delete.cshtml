@model CarCRM.ViewModels.VendaViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3>Tem certeza que deseja excluir?</h3>
<div>
    <h4>Venda</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Data
        </dt>
        <dd class = "col-sm-10">
            @Model.DataVenda.ToString("dd/MM/yyyy")
        </dd>

        <dt class = "col-sm-2">
            Cliente
        </dt>
        <dd class = "col-sm-10">
            @Model.Cliente?.Pessoa?.Nome
        </dd>

        <dt class = "col-sm-2">
            Vendedor
        </dt>
        <dd class = "col-sm-10">
            @Model.Vendedor?.Nome
        </dd>

        <dt class = "col-sm-2">
            Valor da Venda
        </dt>
        <dd class = "col-sm-10">
            @Model.ValorVenda.ToString("C")
        </dd>

        <dt class = "col-sm-2">
            Desconto
        </dt>
        <dd class = "col-sm-10">
            @Model.Desconto.ToString("C")
        </dd>

        <dt class = "col-sm-2">
            Status da Venda
        </dt>
        <dd class = "col-sm-10">
            @Model.StatusVenda?.Nome
        </dd>

        <dt class = "col-sm-2">
            Valor Final
        </dt>
        <dd class = "col-sm-10">
            @Model.ValorFinal.ToString("C")
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>
