@model IEnumerable<CarCRM.Models.Venda>

@{
    ViewData["Title"] = "Index";
}

<h1>Vendas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary"> Novo <i class="bi bi-plus-lg"></i></a>
</p>
<table id="vendaListaId" class="table table-striped js-datatable">
    <thead>
        <tr>
            <th>Data</th>
            <th>Cliente</th>
            <th>Vendedor</th>
            <th>Status</th>
            <th>Valor</th>
            <th>Desconto</th>
            <th>Valor Final</th>
            <th class="no-sort" data-priority="1">Ações</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <th>Data</th>
            <th>Cliente</th>
            <th>Vendedor</th>
            <th>Status</th>
            <th>Valor</th>
            <th>Desconto</th>
            <th>Valor Final</th>
            <th class="no-sort" data-priority="1"></th>
        </tr>
    </tfoot>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.DataVenda.ToString("dd/MM/yyyy")
            </td>
            <td>
                @item.Cliente?.Pessoa.Nome
            </td>
            <td>
                @item.Vendedor?.Nome
            </td>
            <td>
                @item.StatusVenda?.Nome
            </td>            
            <td>
                @item.ValorVenda.ToString("C")
            </td>
            <td>
                @item.Desconto.ToString("C")
            </td>
            <td>
                @item.ValorFinal.ToString("C")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                    <i class="bi bi-pencil-square"></i></a>
                <a asp-action="Details" asp-route-id="@item.Id" title="Detalhes">
                    <i class="bi bi-eye"></i></a>
                <a asp-action="Delete" asp-route-id="@item.Id" title="Excluir">
                    <i class="bi bi-trash"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
