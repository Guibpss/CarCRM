@model CarCRM.ViewModels.VendaViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Criar</h1>

<h4>Venda</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group">
                <label class="control-label">Data da Venda</label>
                <input name="dataVenda" type="date" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="control-label">Cliente</label>
                <select name="clienteId" class="form-control" required >
                    <option value="">Selecione o cliente</option>
                    @foreach (var c in ViewBag.Clientes)
                        {
                            <option value="@c.Id">@c.Pessoa?.Nome</option>
                        }
                    </select>
            </div>

            <div class="form-group">
                <label class="control-label">Vendedor</label>
                @Html.DropDownList("vendedorId",
                    new SelectList(ViewBag.vendedores, "Id", "Nome"),
                    "Selecione o vendedor",
                    new { @class = "form-control" , required = "required"})
            </div>

            <div class="form-group">
                <label class="control-label">Status</label>
                @Html.DropDownList("statusVendaId",
                    new SelectList(ViewBag.StatusVendas, "Id", "Nome"),
                    "Selecione o status",
                    new { @class = "form-control", required = "required" })
            </div>

            <div class="form-group">
                <label class="control-label">Valor da Venda</label>
                <input name="valorVenda" type="text" inputmode="decimal" placeholder="Ex: 15000,50" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="control-label">Desconto</label>
                <input name="desconto" type="text" inputmode="decimal" placeholder="Ex: 0,00" class="form-control" value="0" />
            </div>

            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>
