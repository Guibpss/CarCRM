@model CarCRM.ViewModels.VendaViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Venda</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="form-group">
                <label class="control-label"> Data da Venda</label>
                <input name="dataVenda" type="date" value="@Model.DataVenda.ToString("dd/MM/yyyy")" class="form-control" required />

            </div>
            <div class="form-group">
                <label asp-for="ValorVenda" class="control-label"></label>
                <input asp-for="ValorVenda" class="form-control" />

            </div>
            <div class="form-group">
                <label asp-for="Desconto" class="control-label"></label>
                <input asp-for="Desconto" class="form-control" />

            </div>
           
            <div class="form-group">
                <label class="control-label">Cliente</label>
                <select name="clienteId" class="form-control" required>
                    @foreach (var c in ViewBag.Clientes)
                        {
                            if (c.Id == Model.ClienteId)
                            {
                                <option value="@c.Id" selected>@c.Pessoa?.Nome</option>
                            }
                            else
                            {
                                <option value="@c.Id">@c.Pessoa?.Nome</option>
                            }
                        }
                    </select>

            </div>

            <div class="form-group">
                <label class="control-label">Vendedor</label>
                @Html.DropDownList("vendedorId",
                    new SelectList(ViewBag.vendedores, "Id", "Nome", Model.VendedorId),
                    new { @class = "form-control", required = "required" })
            </div>

            <div class="form-group">
                <label class="control-label">Status</label>
                @Html.DropDownList("statusVendaId",
                    new SelectList(ViewBag.StatusVendas, "Id", "Nome", Model.StatusVendaId),
                    new { @class = "form-control", required = "required" })
            </div>

            <div class="form-group">
                <label class="control-label">Valor da Venda</label>
                <input name="valorVenda" type="number" step="0.01" value="@Model.ValorVenda" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="control-label">Desconto</label>
                <input name="desconto" type="number" step="0.01" value="@Model.Desconto" class="form-control" required />
            </div>
           
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
