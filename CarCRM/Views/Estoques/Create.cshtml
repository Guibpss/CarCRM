@model CarCRM.ViewModels.EstoqueViewModel

@{
    ViewData["Title"] = "Create";
}

<style>
    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>

<div class="container py-5">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-boxes-stacked"></i>
                Cadastrar Estoque
            </h2>

            <small class="text-muted">
                Criação dos dados do estoque
            </small>
        </div>

        <div>

            <button type="submit" form="EstoqueCreate" class="btn btn-success">
                <i class="fa-solid fa-plus"></i>
                Criar
            </button>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar
            </a>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-box"></i>
                </div>

                Dados do Estoque

            </div>
        </div>

        <div class="card-body">

            <form asp-action="Create" id="EstoqueCreate">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-4">

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label asp-for="Nome" class="info-label">Nome</label>
                            <input asp-for="Nome" class="form-control" maxlength="120" required />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Data de Entrada</label>
                            <input name="DataEntrada" type="date" class="form-control" required />
                            <span asp-validation-for="DataEntrada" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="Excluido" class="info-label">Excluido</label>
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Excluido" class="form-check-input" role="switch" />
                            </div>
                            <span asp-validation-for="Excluido" class="text-danger"></span>
                        </div>
                    </div>

                </div>

            </form>

        </div>

    </div>

</div>
