@model CarCRM.ViewModels.StatusPagamentoViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Status de Pagamento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="form-group">
                <label class="control-label">Nome</label>
                <input name="Nome" value="@Model.Nome" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Ativo</label>
                <input name="Ativo" type="checkbox" value="true" class="form-check-input" @(Model.Ativo ? "checked" : "") />
            </div>
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
