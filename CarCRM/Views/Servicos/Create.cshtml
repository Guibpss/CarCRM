@model CarCRM.ViewModels.ServicoViewModel

@{

    ViewData["Title"] = "Create";
}

<h1>Criar</h1>
<h4>Serviço</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div class="form-group">
                <label class="control-label">Nome</label>
                <input name="Nome" class="form-control" required/>
            </div>

            <div class="form-group">
                <label class="control-label">Valor</label>
                <input name="Valor" id="Valor" type="text" class="form-control" required/>
            </div>

            <div class="form-group">
                <label class="control-label">Serviço</label>
                @Html.DropDownList("servicoTipoId",
                    new SelectList(ViewBag.ServicoTipos, "Id", "Nome"),
                    "Selecione o Serviço",
                    new { @class = "form-control" , required = "required"})
            </div>

            <div class="form-group">
                <label class="control-label">Cliente</label>
                @Html.DropDownList("clienteId",
                    new SelectList(ViewBag.Clientes, "Id", "Pessoa.Nome"),
                    "Selecione o Cliente",
                    new { @class = "form-control", required = "required" })
            </div>

            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#Valor').mask('#.##0,00', { reverse: true });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
