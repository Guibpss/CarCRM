@model CarCRM.ViewModels.ServicoViewModel

@{
    ViewData["Title"] = "Edit";
}

<style>
    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>

<div class="container py-5">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-screwdriver-wrench"></i>
                Editar Serviço
            </h2>

            <small class="text-muted">
                Edição dos dados do serviço
            </small>
        </div>

        <div>

            <button type="submit" form="ServicoEditar" class="btn btn-success">
                <i class="fa-solid fa-floppy-disk"></i>
                Salvar
            </button>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-x"></i>
                Cancelar
            </a>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-wrench"></i>
                </div>

                Dados do Serviço

            </div>
        </div>

        <div class="card-body">

            <form asp-action="Edit" id="ServicoEditar">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="row g-4">

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label asp-for="Nome" class="info-label">Nome</label>
                            <input asp-for="Nome" class="form-control" maxlength="120" required />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Valor</label>
                            <input name="Valor" id="Valor" type="text" inputmode="decimal"
                                   value="@Model.Valor.ToString("N2")" class="form-control" required />
                            <span asp-validation-for="Valor" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="ServicoTipoId" class="info-label">Tipo de Serviço</label>
                            <select asp-for="ServicoTipoId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.ServicoTipos, "Id", "Nome"))">
                                <option value="">Selecione o Tipo de Serviço</option>
                            </select>
                            <span asp-validation-for="ServicoTipoId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="ClienteId" class="info-label">Cliente</label>
                            <select asp-for="ClienteId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Clientes, "Id", "Pessoa.Nome"))">
                                <option value="">Selecione o Cliente</option>
                            </select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>
                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            $('#Valor').mask('#.##0,00', { reverse: true });
        });
    </script>

}
