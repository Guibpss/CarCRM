@model CarCRM.ViewModels.ServicoViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3> Tem certeza que deseja Excluir?</h3>
<div>
    <h4>Serviço</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Nome
        </dt>
        <dd class="col-sm-10">
            @Model.Nome
        </dd>

        <dt class="col-sm-2">
            Valor
        </dt>
        <dd class="col-sm-10">
            @Model.Valor.ToString("C")
        </dd>

        <dt class="col-sm-2">
            Serviço
        </dt>
        <dd class="col-sm-10">
            @Model.ServicoTipo?.Nome
        </dd>

        <dt class="col-sm-2">
            Cliente
        </dt>
        <dd class="col-sm-10">
            @Model.Cliente?.Pessoa?.Nome
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>