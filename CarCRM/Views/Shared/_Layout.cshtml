<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarCRM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarCRM.styles.css" asp-append-version="true" />
    <style>
            .footer-basic {
                padding: 10px 0;
                background-color: #f8f9fa;
                color: white;
            }

                .footer-basic .copyright {
                    margin-top: 15px;
                    text-align: center;
                    font-size: 13px;
                    color: black;
                    margin-bottom: 0;
                }

            .navbar-dark .nav-item .nav-link {
                color: #fff;
            }

                .navbar-dark .nav-item .nav-link:hover {
                    background-color: rgba(255, 255, 255, 0.1);
                    transition: all 0.3s ease;
                    border-radius: 0.25rem;
                    color: #fff;
                }

            .fa-li {
                position: relative;
                left: 0;
            }
    </style>
</head>
<body>
    <header>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Navbar brand -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CarCRM</a>

                <!-- Toggle button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars"></i>
                </button>

                <!-- Collapsible wrapper -->
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <!-- Left links -->
                    @{
                        var isLogin = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                                   && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
                    }

                    <!-- Left links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (!isLogin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="menuCadastros" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Cadastros</a>
                                <ul class="dropdown-menu" aria-labelledby="menuCadastros">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuário</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Clientes" asp-action="Index">Cliente</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="menuOperacoes" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Operações</a>
                                <ul class="dropdown-menu" aria-labelledby="menuOperacoes">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Estoques" asp-action="Index">Estoque</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Veiculos" asp-action="Index">Veículo</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Vendas" asp-action="Index">Venda</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Servicos" asp-action="Index">Serviço</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="menuPagamentos" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Pagamentos</a>
                                <ul class="dropdown-menu" aria-labelledby="menuPagamentos">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Pagamento" asp-action="Index">Pagamento</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <!-- Left links -->
                    <!-- Left links -->
                    <!-- Right elements -->
                    @if (!isLogin)
                    {
                        <ul class="navbar-nav mb-2 mb-lg-0 align-items-center">
                            <!-- Notificações (sino) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle hidden-arrow" href="#" id="navbarDropdownBell" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-bell"></i>
                                    <span class="badge rounded-pill bg-danger">1</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownBell">
                                    <li><a class="dropdown-item" href="#">Nova notificação</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="#">Outra notificação</a></li>
                                </ul>
                            </li>

                            <!-- Avatar / Perfil -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownAvatar" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle fa-lg"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownAvatar">
                                    <li><a class="dropdown-item" href="~/Home/EditarPerfil">Meu perfil</a></li>
                                    <li><a class="dropdown-item" href="#">Configurações</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Index">Sair</a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    <!-- Right elements -->
                </div>
                <!-- Collapsible wrapper -->
            </div>
        </nav>
        <!-- Navbar -->

    </header>
    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="footer-basic">
        <footer>
            <hr style="height:2px;border-width:0;color:gray;background-color:white">
            <p class="copyright">Copyright © 2026 CarCRM. Todos os direitos reservados.</p>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/validation-pt-BR.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
