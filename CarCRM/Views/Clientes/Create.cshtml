@model CarCRM.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Criar</h1>

<h4>Cliente</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" id="ClientCreate">
            <div class="form-group">
                <label class="control-label">Pessoa</label>
                <select name="tipoPessoa" id="tipoPessoa" class="form-control">
                    <option value="">Selecione </option>>
                    <option value="pessoaFisica">Pessoa Física</option>>
                    <option value="pessoaJuridica">Pessoa Jurídica</option>>
                </select>                
            </div>

            <div class="form-group">
                <label class="control-label">Nome</label>
                <input name="Pessoa.nome" class="form-control" required/>
            </div>

            <div class="form-group">
                <label class="control-label">Email</label>
                <input name="Pessoa.email" class="form-control" required />
            </div>

            <div id="camposPF" style="display:none;">
                <div class="form-group">
                    <label class="control-label">CPF</label>
                    <input name="cpf" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">RG</label>
                    <input name="rg" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="control-label">Data de Nascimento</label>
                    <input name="dataNascimento" type="date" class="form-control" required />
                </div>
            </div>
            <div id="camposPJ" style="display:none;">
                <div class="form-group">
                    <label class="control-label">CNPJ</label>
                    <input name="cnpj" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">Razao Social</label>
                    <input name="razaoSocial" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">Nome Fantasia</label>
                    <input name="nomeFantasia" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">Nome Interno</label>
                    <input name="nomeInterno" class="form-control" required />
                </div>
            </div>
            <br />
            <hr />
            <div class="form-group ">
                <h4>Telefone</h4>
                <div style="display: flex; align-items: flex-end; gap: 10px;" >
                    <div>
                        <label class="control-label">Tipo</label>
                        @Html.DropDownList("Pessoa.Telefones[0].TelefoneTipoId",
                        new SelectList(ViewBag.telefonesTipo, "Id", "Nome"),
                        new { @class = "form-control" })
                    </div>
                    <div style="width: 80px">
                        <label class="control-label">DDD</label>
                        <input name="Pessoa.Telefones[0].DDD" class="form-control" required/>
                    </div>
                    <div style="flex: 1;">
                        <label class="control-label">Número</label>
                        <input name="Pessoa.Telefones[0].Numero" class="form-control" required/>
                    </div>
            </div>
        </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts 
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/validation-pt-BR.js"></script>

<script>
    $(function() {

        function alterarCampos() {

            var tipo = $("#tipoPessoa").val();

            if (tipo == "pessoaFisica") {

                $("#camposPF").show();
                $("#camposPJ").hide();

                $("#camposPF :input").prop("disabled", false);
                $("#camposPJ :input").prop("disabled", true);

            } else if(tipo == "pessoaJuridica") {

                $("#camposPF").hide();
                $("#camposPJ").show();

                $("#camposPF :input").prop("disabled", true);
                $("#camposPJ :input").prop("disabled", false);

            } else {

                $("#camposPF").hide();
                $("#camposPJ").hide();

                $("#camposPF :input").prop("disabled", true);
                $("#camposPJ :input").prop("disabled", true);
           }
        }  
          
        $("#ClientCreate").validate();
             
        alterarCampos();

        $("#tipoPessoa").on("change", alterarCampos);

    });
</script>

}