@model CarCRM.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Edit";
    var pf = Model.Pessoa as CarCRM.ViewModels.PessoaFisicaViewModel;
    var pj = Model.Pessoa as CarCRM.ViewModels.PessoaJuridicaViewModel;
    var telefone = Model.Pessoa?.Telefones?.FirstOrDefault();
}

<h1>Editar</h1>

<h4>Cliente</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" id="ClientEdit">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="tipoPessoa" value="@(pf != null ? "pessoaFisica" : "pessoaJuridica")" />
            <div class="form-group">
                <label class="control-label">Nome</label>
                <input name="Pessoa.Nome" minlength="2" value="@Model.Pessoa.Nome" class="form-control"  required/>
            </div>          
            <div>
                <label class="control-label">Email</label>
                <input name="Pessoa.Email" value="@Model.Pessoa?.Email" class="form-control" required />
            </div>
            <div id="camposPF" style="display:@(pf != null ? "block" : "none");">
                <div class="form-group">
                    <label class="control-label">CPF</label>
                    <input name="CPF" value="@pf?.CPF" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">RG</label>
                    <input name="RG" value="@pf?.RG" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="control-label">Data de Nascimento</label>
                    <input name="DataNascimento" value="@Model.DataNascimento.ToString("dd/MM/yyyy")" type="date" class="form-control" required />
                </div>
            </div>
            <div id="camposPJ" style="display:@(pj != null ? "block" : "none");">
                <div class="form-group">
                    <label class="control-label">CNPJ</label>
                    <input name="CNPJ" value="@pj?.CNPJ" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">Razao Social</label>
                    <input name="RazaoSocial" value="@pj?.RazaoSocial" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">Nome Fantasia</label>
                    <input name="NomeFantasia" value="@pj?.NomeFantasia" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="control-label">Nome Interno</label>
                    <input name="NomeInterno" value="@pj?.NomeInterno" class="form-control" required />
                </div>
            </div>

            @* <div class="form-group">
                <label class="control-label">Excluido</label>
                <input name="excluido" type="checkbox" value="true" class="form-check-input" @(Model.Excluido ? "checked" : "") />
            </div> *@
            <div>
                <br />
                <h4>Telefone</h4>
                <hr />
                <div style="display: flex; align-items: flex-end; gap: 10px;">
                    <div>
                        <label class="control-label">Tipo</label>
                        @Html.DropDownList("Pessoa.Telefones[0].TelefoneTipoId",
                        new SelectList(ViewBag.telefonesTipo, "Id", "Nome", telefone?.TelefoneTipoId),
                        new { @class = "form-control" })
                    </div>
                </div>
                <div style="width: 80px;">
                    <label class="control-label">DDD</label>
                    <input name="Pessoa.Telefones[0].DDD" value="@telefone?.DDD" class="form-control" />
                </div>
                <div style="flex: 1;">
                    <label class="control-label">Número</label>
                    <input name="Pessoa.Telefones[0].Numero" value="@telefone?.Numero" class="form-control" />
                </div>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
   
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(function() {
            $("#ClientEdit").validate();
        });
    </script>
}
