@model CarCRM.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Edit";

    var pf = Model.Pessoa as CarCRM.ViewModels.PessoaFisicaViewModel;
    var pj = Model.Pessoa as CarCRM.ViewModels.PessoaJuridicaViewModel;
    var telefone = Model.Pessoa?.Telefones?.FirstOrDefault();

    if (pf != null)
    {
        Model.CPF = pf.CPF;
        Model.RG = pf.RG;
        Model.DataNascimento = pf.DataNascimento;
    }

    if (pj != null)
    {
        Model.CNPJ = pj.CNPJ;
        Model.RazaoSocial = pj.RazaoSocial;
        Model.NomeFantasia = pj.NomeFantasia;
        Model.NomeInterno = pj.NomeInterno;
    }

    var tipoPessoa = pf != null
        ? "pessoaFisica"
        : pj != null
            ? "pessoaJuridica"
            : (!string.IsNullOrWhiteSpace(Model.CPF) ? "pessoaFisica" : "pessoaJuridica");

    var ehPessoaFisica = tipoPessoa == "pessoaFisica";
}

<style>
    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>

<div class="container py-5">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-users"></i>
                Editar Cliente
            </h2>

            <small class="text-muted">
                Edição dos dados cadastrais
            </small>
        </div>

        <div>

            <button type="submit" form="ClienteEditar" class="btn btn-success">
                <i class="fa-solid fa-floppy-disk"></i>
                Salvar
            </button>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-x"></i>
                Cancelar
            </a>

        </div>
    </div>

    <form asp-action="Edit" id="ClienteEditar">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="tipoPessoa" value="@tipoPessoa" />

        <div class="card mb-4">
            <div class="card-header">
                <div class="section-title">

                    <div class="icon-box">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>

                    Dados do Cliente

                </div>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Tipo de Pessoa</label>
                            <input class="form-control"
                                   value="@(ehPessoaFisica ? "Pessoa Física" : "Pessoa Jurídica")"
                                   readonly />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label asp-for="Pessoa.Nome" class="info-label">Nome</label>
                            <input asp-for="Pessoa.Nome" class="form-control" maxlength="120" required />
                            <span asp-validation-for="Pessoa.Nome" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="form-group">
                            <label asp-for="Pessoa.Email" class="info-label">Email</label>
                            <input asp-for="Pessoa.Email" type="email" class="form-control" maxlength="150" required />
                            <span asp-validation-for="Pessoa.Email" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <div id="camposPF" class="row g-4 mt-1" style="display:@(ehPessoaFisica ? "flex" : "none");">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="CPF" class="info-label">CPF</label>
                            <input asp-for="CPF" class="form-control" maxlength="14" required />
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="RG" class="info-label">RG</label>
                            <input asp-for="RG" class="form-control" maxlength="20" required />
                            <span asp-validation-for="RG" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="DataNascimento" class="info-label">Data de Nascimento</label>
                            <input asp-for="DataNascimento" type="date" class="form-control" required />
                            <span asp-validation-for="DataNascimento" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <div id="camposPJ" class="row g-4 mt-1" style="display:@(ehPessoaFisica ? "none" : "flex");">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="CNPJ" class="info-label">CNPJ</label>
                            <input asp-for="CNPJ" class="form-control" maxlength="18" required />
                            <span asp-validation-for="CNPJ" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="RazaoSocial" class="info-label">Razão Social</label>
                            <input asp-for="RazaoSocial" class="form-control" maxlength="150" required />
                            <span asp-validation-for="RazaoSocial" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="NomeFantasia" class="info-label">Nome Fantasia</label>
                            <input asp-for="NomeFantasia" class="form-control" maxlength="150" required />
                            <span asp-validation-for="NomeFantasia" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label asp-for="NomeInterno" class="info-label">Nome Interno</label>
                            <input asp-for="NomeInterno" class="form-control" maxlength="150" required />
                            <span asp-validation-for="NomeInterno" class="text-danger"></span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <div class="card mb-4">
            <div class="card-header">
                <div class="section-title">

                    <div class="icon-box">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    Telefone

                </div>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Tipo</label>
                            @Html.DropDownList("Pessoa.Telefones[0].TelefoneTipoId",
                                    new SelectList(ViewBag.telefonesTipo, "Id", "Nome", telefone?.TelefoneTipoId),
                                    "Selecione o Tipo",
                                    new { @class = "form-select", required = "required" })
                            @Html.ValidationMessage("Pessoa.Telefones[0].TelefoneTipoId", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <div class="form-group">
                            <label class="info-label">DDD</label>
                            <input name="Pessoa.Telefones[0].DDD" value="@telefone?.DDD" class="form-control" maxlength="2" required />
                            @Html.ValidationMessage("Pessoa.Telefones[0].DDD", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label class="info-label">Número</label>
                            <input name="Pessoa.Telefones[0].Numero" value="@telefone?.Numero" class="form-control" maxlength="10" required />
                            @Html.ValidationMessage("Pessoa.Telefones[0].Numero", new { @class = "text-danger" })
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <script>
        $(function () {

            var ehPessoaFisica = @(ehPessoaFisica ? "true" : "false");

            $("#camposPF :input").prop("disabled", !ehPessoaFisica);
            $("#camposPJ :input").prop("disabled", ehPessoaFisica);

        });
    </script>

}
