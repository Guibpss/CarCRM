@model IEnumerable<CarCRM.ViewModels.PessoaJuridicaViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Pessoas Jurídicas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary"> Novo <i class="bi bi-plus-lg"></i></a>
</p>
<table id="pessoaJuridicaListaId" class="table table-striped js-datatable">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>CNPJ</th>
            <th>Razão Social</th>
            <th>Nome Fantasia</th>
            <th class="no-sort" data-priority="1">Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Nome</td>
            <td>@item.Email</td>
            <td>
                @foreach (var telefone in item.Telefones)
                {
                    var numeroCompleto = "(" + telefone.DDD + ") " + telefone.Numero;
                    <span>@numeroCompleto</span> <br />
                }
            </td>
            <td>@item.CNPJ</td>
            <td>@item.RazaoSocial</td>
            <td>@item.NomeFantasia</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                    <i class="bi bi-pencil-square"></i></a>
                <a asp-action="Details" asp-route-id="@item.Id" title="Detalhes">
                    <i class="bi bi-eye"></i></a>
                <a asp-action="Delete" asp-route-id="@item.Id" title="Excluir">
                    <i class="bi bi-trash"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
