@model CarCRM.ViewModels.PessoaJuridicaViewModel

@{
    ViewData["Title"] = "Details";
    var telefone = Model.Telefones?.FirstOrDefault();
}

<h1>Detalhes</h1>

<div>
    <h4>Pessoa Jurídica</h4>
    <hr />
    <dl>
        <dt class="col-sm-2">
            Nome
        </dt>
        <dd class="col-sm-10">
            @Model.Nome
        </dd>

        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.Email
        </dd>

        <dt class="col-sm-2">
            CNPJ
        </dt>
        <dd class="col-sm-10">
            @Model.CNPJ
        </dd>

        <dt class="col-sm-2">
            Razão Social
        </dt>
        <dd class="col-sm-10">
            @Model.RazaoSocial
        </dd>

        <dt class="col-sm-2">
            Nome Fantasia
        </dt>
        <dd class="col-sm-10">
            @Model.NomeFantasia
        </dd>

        <dt class="col-sm-2">
            Nome Interno
        </dt>
        <dd class="col-sm-10">
            @Model.NomeInterno
        </dd>

        <dt class="col-sm-2">
            Excluido
        </dt>
        <dd class="col-sm-10">
            @(Model.Excluido ? "Sim" : "Não")
        </dd>

        <dt class="col-sm-2">
            Criado Em
        </dt>
        <dd class="col-sm-10">
            @Model.CriadoEm.ToString("dd/MM/yyyy")
        </dd>

        <div>
            <br />
            <h4>Telefone</h4>
            <hr />
            <div style="display: flex; align-items: flex-end; gap: 10px;">
                <div>
                    <label class="control-label">Tipo</label>
                    @Html.DropDownList("telefonetipoId",
                    new SelectList(ViewBag.telefonesTipo, "Id", "Nome", telefone?.TelefoneTipoId),
                    new { @class = "form-control", disabled = "disabled" })
                </div>
            </div>
            <div style="width: 80px;">
                <dt class="col-sm-2">
                    DDD
                </dt>
                <dd class="col-sm-10">
                    @telefone?.DDD
                </dd>
            </div>
            <div style="flex: 1px;">
                <dt class="col-sm-2">
                    Número
                </dt>
                <dd class="col-sm-10">
                    @telefone?.Numero
                </dd>
            </div>
        </div>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Voltar</a>
</div>
