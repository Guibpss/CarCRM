@section Scripts {
    <script>
        var ID_PAGO = 1;
        var ID_CREDITO = 2;

        function alternarDataCompraPagamento() {
            var pago = $("#pagCompraProduto_StatusPagamentoId").val() == ID_PAGO;
            $("#pagCompraProduto_campoDataPagamento").toggleClass('d-none', !pago);
            $("#pagCompraProduto_DataPagamento").prop('disabled', !pago);
        }

        function alternarParcelaCompraMetodoPagamento() {
            var metodo = $("#pagCompraProduto_MetodoPagamentoId").val() == ID_CREDITO;
            $("#pagCompraProduto_campoParcelas").toggleClass('d-none', !metodo);
            $("#pagCompraProduto_Parcelas").prop('disabled', !metodo);
        }

        function alternarDataVendaPagamento() {
            var pago = $("#pagVendaProduto_StatusPagamentoId").val() == ID_PAGO;
            $("#pagVendaProduto_campoDataPagamento").toggleClass('d-none', !pago);
            $("#pagVendaProduto_DataPagamento").prop('disabled', !pago);
        }

        function alternarParcelaVendaMetodoPagamento() {
            var metodo = $("#pagVendaProduto_MetodoPagamentoId").val() == ID_CREDITO;
            $("#pagVendaProduto_campoParcelas").toggleClass('d-none', !metodo);
            $("#pagVendaProduto_Parcelas").prop('disabled', !metodo);
        }

        function alternarDataCompraProdutoPagamentoEdit() {
            var pago = $("#pagCompraProdutoEdit_StatusPagamentoId").val() == ID_PAGO;
            $("#pagCompraProdutoEdit_campoDataPagamento").toggleClass('d-none', !pago);
            $("#pagCompraProdutoEdit_DataPagamento").prop('disabled', !pago);
        }

        function alternarParcelaCompraMetodoPagamentoEdit() {
