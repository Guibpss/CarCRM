@if (Model.CompraProduto != null && Model.CompraProduto?.Id != 0)
{

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                <i class="fa-solid fa-tags text-primary"></i>
                Venda
            </h2>

            <small class="text-muted">
                Gerencie a venda do produto cadastrada.
            </small>

        </div>

        <div class="d-flex gap-2">
            @if (Model.VendaProduto == null || Model.VendaProduto.Id == 0)
            {
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#vendaProdutoModal">
                    <i class="fa-solid fa-plus"></i>
                        Adicionar Venda
                </button>
            }
            else
            {
                <a href="#" class="btn btn-warning btn-editar-venda" data-id="@Model.VendaProduto.Id">
                    <i class="fa-solid fa-pencil"></i> Editar
                </a>
                <button type="button" class="btn btn-danger btn-excluir-venda"
                        data-id="@Model.VendaProduto.Id" data-bs-toggle="modal"
                        data-bs-target="#vendaProdutoModalDelete">
                        <i class="fa-solid fa-trash-can"></i> Excluir
                </button>
            }
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">

        </div>

        <div class="card-body">
            @if (Model.VendaProduto == null || Model.VendaProduto.Id == 0)
            {
                <p class="text-muted mb-0">Nenhuma venda cadastrada para este produto.</p>
            }
            else
            {
                
                <div class="row g-4">

                    <div class="col-md-3">
                        <div class="info-label">Data da Venda</div>
                        <div class="info-value">@Model.VendaProduto.DataVenda.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Cliente</div>
                        <div class="info-value"> @Model.VendaProduto.Cliente?.Pessoa?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Status</div>
                        <div class="info-value">@Model.VendaProduto.StatusVenda?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor da Venda</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.VendaProduto.ValorVenda)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Desconto</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.VendaProduto.Desconto)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor Final</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.VendaProduto.ValorFinal)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Criado Em</div>
                        <div class="info-value">@Model.VendaProduto.CriadoEm.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Excluido</div>
                        <div class="info-value">@(Model.VendaProduto.Excluido ? "Sim" : "Não")</div>
                    </div>

                </div>
            }
        </div>

        <div class="container-fluid py-5">
            @if (Model.VendaProduto == null || Model.VendaProduto.Id == 0)
            {
                <p class="text-muted mb-0"></p>
            }
            else
            {
                var totalRecebido = Model.PagamentosProdutoVenda?.Sum(p => p.Valor) ?? 0;
                var valorFinalVenda = (decimal)Model.VendaProduto.ValorFinal;

                <div class="d-flex justify-content-end align-items-center mb-4">

                    @if (totalRecebido < valorFinalVenda)
                    {
                        <div>
                            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#pagVendaProdutoModal">
                                <i class="fa-solid fa-plus"></i>
                                Adicionar Pagamento
                            </button>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            <i class="fa-solid fa-check"></i> Pagamento quitado
                        </span>
                    }
                </div>

                <div class="card shadow-sm">

                    <div class="card-header">

                        <div class="section-title">

                            <div class="icon-box">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>

                            Pagamentos Cadastrados

                        </div>

                    </div>

                    <div class="card-body">

                        <table id="pagVendaProdutoListaId" class="table table-hover align-middle js-datatable">
                            <thead class="table-light">
                                <tr>
                                    <th>Valor</th>
                                    <th>Parcelas</th>
                                    <th>Vencimento</th>
                                    <th>Pagamento</th>
                                    <th>Método</th>
                                    <th>Status</th>
                                    <th class="text-center no-sort" data-priority="1">Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.PagamentosProdutoVenda)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">
                                                R$ @String.Format("{0:N2}", item.Valor)
                                            </span>
                                        </td>

                                        <td>
                                            @item.Parcelas
                                        </td>

                                        <td>
                                            @item.DataVencimento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.DataPagamento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.MetodoPagamento?.Nome
                                        </td>

                                        <td>
                                            @if (item.StatusPagamentoId == 1)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>

                                            }
                                            else if (item.StatusPagamentoId == 2)
                                            {
                                                <span class="badge bg-primary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 3)
                                            {
                                                <span class="badge bg-warning">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 4)
                                            {
                                                <span class="badge bg-secondary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 5)
                                            {
                                                <span class="badge bg-info">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 7)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 9)
                                            {
                                                <span class="badge bg-danger">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1 flex-nowrap">

                                                <a href="#"
                                                    class="btn btn-outline-warning btn-sm btn-editar-pagamentovenda"
                                                    data-bs-toggle="modal-edit-pagamento"
                                                    data-bs-target="#pagVendaProdutoModalEdit"
                                                    data-id="@item.Id"
                                                    title="Editar">
                                                        <i class="fa-solid fa-pen"></i>
                                                </a>

                                                <button type="button"
                                                 class="btn btn-outline-danger btn-sm btn-excluir-pagamentovenda"
                                                 data-id="@item.Id"
                                                 data-bs-toggle="modal"
                                                 data-bs-target="#pagVendaProdutoModalDelete"
                                                 title="Excluir">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
    
}

