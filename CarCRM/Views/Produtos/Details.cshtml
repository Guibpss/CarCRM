            $("#pagCompraProdutoEdit_campoParcelas").toggleClass('d-none', !metodo);
            $("#pagCompraProdutoEdit_Parcelas").prop('disabled', !metodo);
        }

        function alternarDataVendaProdutoPagamentoEdit() {
