@model CarCRM.ViewModels.ProdutoViewModel

@{
    ViewData["Title"] = "Details";
}

<style>
    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>

<div class="container py-5">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-box text-primary"></i>
                Visualizar Produto
            </h2>

            <small class="text-muted">
                Visualização dos dados do produto
            </small>
        </div>

        <div>
            <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="fa-solid fa-pencil"></i>
                Editar
            </a>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar
            </a>

        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-wrench"></i>
                </div>

                Dados do Produto
            </div>
        </div>

    
        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-3">
                    <div class="info-label">Nome</div>
                    <div class="info-value">@Model.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Valor</div>
                    <div class="info-value">R$ @String.Format("{0:N2}", Model.Valor)</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Quantidade</div>
                    <div class="info-value">@Model.Quantidade</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Valor Final</div>
                    <div class="info-value">R$ @String.Format("{0:N2}", Model.ValorFinal)</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Produto Tipo</div>
                    <div class="info-value">@Model.ProdutoTipo?.Nome</div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                <i class="fa-solid fa-file-invoice-dollar text-primary"></i>
                Compra
            </h2>

            <small class="text-muted">
                Gerencie a compra cadastrada.
            </small>

        </div>

        <div class="d-flex gap-2">
            @if (Model.CompraProduto == null || Model.CompraProduto.Id ==0)
            {
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#compraProdutoModal">
                    <i class="fa-solid fa-plus"></i> Adicionar Compra
                </button>
            }
            else
            {
                <a href="#" class="btn btn-warning btn-editar-compra" data-id="@Model.CompraProduto.Id">
                    <i class="fa-solid fa-pencil"></i> Editar
                </a>
                <button type="button" class="btn btn-danger btn-excluir-compra"
                        data-id="@Model.CompraProduto.Id" data-bs-toggle="modal"
                        data-bs-target="#compraProdutoModalDelete">
                        <i class="fa-solid fa-trash-can"></i> Excluir
                </button>
            }
        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header">

        </div>

        <div class="card-body">
            @if (Model.CompraProduto == null || Model.CompraProduto.Id == 0)
            {
                <p class="text-muted mb-0">Nenhuma compra cadastrada para este produto.</p>
            }
            else
            {
                <div class="row g-4">

                    <div class="col-md-3">
                        <div class="info-label">Data da Compra</div>
                        <div class="info-value">@Model.CompraProduto.DataCompra.ToString("dd/MM/yyyy")</div>
                    </div>

                     <div class="col-md-3">
                        <div class="info-label">Fornecedor</div>
                        <div class="info-value">@Model.CompraProduto.Fornecedor?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Status</div>
                        <div class="info-value">@Model.CompraProduto.StatusCompra?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor da Compra</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.CompraProduto.ValorCompra)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Desconto</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.CompraProduto.Desconto)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor Final</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.CompraProduto.ValorFinal)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Criado Em</div>
                        <div class="info-value">@Model.CompraProduto.CriadoEm.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Excluido</div>
                        <div class="info-value">@(Model.CompraProduto.Excluido ? "Sim" : "Não")</div>
                    </div>

                </div>
            }
        </div>

        <div class="container-fluid py-5">
            @if (Model.CompraProduto == null || Model.CompraProduto.Id ==0)
            {
                <p class="text-muted mb-0"></p>
            }
            else
            {
                var totalPago = Model.PagamentosProdutoCompra?.Sum(p => p.Valor) ?? 0;
                var valorFinal = (decimal)Model.CompraProduto.ValorFinal;

                <div class="d-flex justify-content-end align-items-center mb-4">

                    @if (totalPago < valorFinal)
                    {
                     <div>
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#pagCompraProdutoModal">
                            <i class="fa-solid fa-plus"></i>
                            Adicionar Pagamento
                        </button>
                    </div>

                    } else
                    {
                       <span class="badge bg-success">
                            <i class="fa-solid fa-check"></i> Pagamento quitado
                       </span> 
                    }
                </div>

                <div class="card shadow-sm">

                    <div class="card-header">

                        <div class="section-title">

                            <div class="icon-box">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>

                            Pagamentos Cadastrados

                        </div>

                    </div>

                    <div class="card-body">

                        <table id="pagCompraProdutoListaId" class="table table-hover align-middle js-datatable">
                            <thead class="table-light">
                                <tr>
                                    <th>Valor</th>
                                    <th>Parcelas</th>
                                    <th>Vencimento</th>
                                    <th>Pagamento</th>
                                    <th>Método</th>
                                    <th>Status</th>
                                    <th class="text-center no-sort" data-priority="1">Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.PagamentosProdutoCompra)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">
                                                R$ @String.Format("{0:N2}", item.Valor)
                                            </span>
                                        </td>

                                        <td>
                                            @item.Parcelas
                                        </td>

                                        <td>
                                            @item.DataVencimento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.DataPagamento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.MetodoPagamento?.Nome
                                        </td>

                                        <td>
                                            @if (item.StatusPagamentoId == 1)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>

                                            }
                                            else if (item.StatusPagamentoId == 2)
                                            {
                                                <span class="badge bg-primary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 3)
                                            {
                                                <span class="badge bg-warning">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 4)
                                            {
                                                <span class="badge bg-secondary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 5)
                                            {
                                                <span class="badge bg-info">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 7)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 9)
                                            {
                                                <span class="badge bg-danger">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1 flex-nowrap">

                                                <a href="#"
                                                    class="btn btn-outline-warning btn-sm btn-editar-pagamentocompraproduto"
                                                    data-bs-toggle="modal-edit-pagamento"
                                                    data-bs-target="#pagCompraProdutoModalEdit"
                                                    data-id="@item.Id"
                                                    title="Editar">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>

                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm btn-excluir-pagamentocompraproduto"
                                                        data-id="@item.Id"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#pagCompraProdutoModalDelete"
                                                        title="Excluir">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="pagCompraProdutoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Adicionar Pagamento da Compra</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="info-label">Valor</label>
                        <input id="pagCompraProduto_Valor" type="text" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none" id="pagCompraProduto_campoParcelas">
                        <label class="info-label">Parcelas</label>
                        <input id="pagCompraProduto_Parcelas" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Data Vencimento</label>
                        <input id="pagCompraProduto_DataVencimento" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none" id="pagCompraProduto_campoDataPagamento">
                        <label class="info-label">Data Pagamento</label>
                        <input id="pagCompraProduto_DataPagamento" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Método de Pagamento</label>
                        @Html.DropDownList("pagCompraProduto_MetodoPagamentoId",
                            new SelectList(ViewBag.MetodoPagamento, "Id", "Nome"),
                            "Selecione", new {@class = "form-select"})
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Status</label>
                        @Html.DropDownList("pagCompraProduto_StatusPagamentoId",
                            new SelectList(ViewBag.StatusPagamento, "Id", "Nome"),
                            "Selecione", new {@class = "form-select"})
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="adicionarPagamentoCompraProduto()">Adicionar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pagCompraProdutoModalEdit" tabindex="-1" aria-labelledby="pagCompraProdutoModalLabelEdit" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="pagCompraProdutoModalLabelEdit">Editar Pagamento</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="card-body">

                <form asp-action="Edit" id="PagCompraProdutoEditar">
                    <input type="hidden" id="pagCompraProdutoEdit_Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="info-label">Valor</label>
                            <input name="Valor" id="pagCompraProdutoEdit_Valor" type="text" class="form-control" />
                        </div>
                        <div class="col-md-6 d-none" id="pagCompraProdutoEdit_campoParcelas">
                            <label class="info-label">Parcelas</label>
                            <input name="Parcelas" id="pagCompraProdutoEdit_Parcelas" type="number" min="1" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="info-label">Data Vencimento</label>
                            <input name="DataVencimento" id="pagCompraProdutoEdit_DataVencimento" type="date" class="form-control"/>
                        </div>
                        <div class="col-md-6 d-none" id="pagCompraProdutoEdit_campoDataPagamento">
                            <label class="info-label">Data Pagamento</label>
                            <input name="DataPagamento" id="pagCompraProdutoEdit_DataPagamento" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="info-label">Método de Pagamento</label>
                            @Html.DropDownList("pagCompraProdutoEdit_MetodoPagamentoId",
                                new SelectList(ViewBag.MetodoPagamento, "Id", "Nome"),
                                "Selecione", new { @class = "form-select" })
                        </div>
                        <div class="col-md-6">
                            <label class="info-label">Status</label>
                            @Html.DropDownList("pagCompraProdutoEdit_StatusPagamentoId",
                                new SelectList(ViewBag.StatusPagamento, "Id", "Nome"),
                                "Selecione", new { @class = "form-select" })
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="pagCompraProdutoEditarPagamento()">Salvar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pagCompraProdutoModalDelete" tabindex="-1" aria-labelledby="pagCompraProdutoModalLabelDelete" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="pagCompraProdutoModalLabelDelete">Confirmar Exclusão?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="text-center">

                    <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 45px;">
                    </i>

                    <h5 class="mt-3">
                        Tem certeza que deseja excluir este pagamento?
                    </h5>

                    <p class="text-muted mb-0">
                        Essa ação não poderá ser desfeita!
                    </p>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>

                <form id="pagCompraProdutoDeleteForm" asp-action="ExcluirPagamentoProdutoCompra" method="post">
                    <input type="hidden" id="pagCompraProdutoDeleteId" name="id" />
                    <input type="hidden" name="produtoId" value="@Model.Id"/>

                    <button type="submit" class="btn btn-danger" name="pagamento_delete" id="pagCompraProdutoDeleteButton">
                        <i class="fa-solid fa-trash-can"></i>
                        Excluir
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compraProdutoModal" tabindex="-1" aria-labelledby="compraProdutoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="compraProdutoModalLabel">Adicionar Compra</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Create" id="CompraProdutoCreate">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Data da Compra</label>
                                <input name="DataCompra" id="DataCompra" type="date" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Fornecedor</label>
                                @Html.DropDownList("FornecedorId",
                                    new SelectList(ViewBag.fornecedores, "Id", "Nome"),
                                    "Selecione",
                                    new { @class = "form-control"})
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Status</label>
                                @Html.DropDownList("StatusCompraId",
                                      new SelectList(ViewBag.statuscompras, "Id", "Nome"),
                                        "Selecione",
                                      new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Valor da Compra</label>
                                <input name="ValorCompra" id="ValorCompra" type="text" inputmode="decimal" placeholder="Ex: 0,00" value="0,00" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Desconto</label>
                                <input name="Desconto" id="DescontoCompra" type="text" inputmode="decimal" placeholder="Ex: 0,00" value="0,00" class="form-control" required />
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="adicionarCompraProduto()">Adicionar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compraProdutoModalEdit" tabindex="-1" aria-labelledby="compraProdutoModalLabelEdit" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="compraProdutoModalLabelEdit">Editar Compra</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="card-body">

                <form asp-action="Edit" id="CompraEditar">
                    <input type="hidden" id="CompraEdit_Id" />

                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Data da Compra</label>
                                <input name="DataCompra" id="CompraEdit_Data" type="date" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="info-label">Fornecedor</label>
                                @Html.DropDownList("edit_FornecedorId",
                                        new SelectList(ViewBag.fornecedores, "Id", "Nome"),
                                        "Selecione",
                                        new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="info-label">Status</label>
                                @Html.DropDownList("edit_StatusCompraId",
                                        new SelectList(ViewBag.statuscompras, "Id", "Nome"),
                                        "Selecione",
                                        new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Valor da Compra</label>
                                <input name="ValorCompra" id="Edit_ValorCompra" type="text" inputmode="decimal"
                                       placeholder="Ex.: 15.000,50" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Desconto</label>
                                <input name="Desconto" id="Edit_DescontoCompra" type="text" inputmode="decimal"
                                       placeholder="Ex.: 0,00" value="0,00" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="editarCompraProduto()">Salvar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compraProdutoModalDelete" tabindex="-1" aria-labelledby="compraProdutoModalLabelDelete" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="compraProdutoModalLabelDelete">Confirmar Exclusão?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="text-center">

                    <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 45px;"></i>

                    <h5 class="mt-3">
                        Tem certeza que deseja excluir esta compra?
                    </h5>

                    <p class="text-muted mb-0">
                        Essa ação não poderá ser desfeita!
                    </p>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>

