@model CarCRM.ViewModels.PessoaViewModel

@{
    ViewData["Title"] = "Delete";
    var telefone = Model.Telefones?.FirstOrDefault();
}

<h1>Excluir</h1>

<h3>Tem certeza que deseja excluir?</h3>
<div>
    <h4>Pessoa</h4>
    <hr />
    <dl>
        <dt class="col-sm-2">
            Nome
        </dt>
        <dd class="col-sm-10">
            @Model.Nome
        </dd>

        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.Email
        </dd>

        <dt class="col-sm-2">
            Excluido
        </dt>
        <dd class="col-sm-10">
            @(Model.Excluido ? "Sim" : "Não")
        </dd>

        <div>
            <br />
            <h4>Telefone</h4>
            <hr />
            <div style="display: flex; align-items:flex-end; gap: 10px;">
                <div>
                    <label class="control-label">Tipo</label>
                    @Html.DropDownList("telefonetipoId",
                    new SelectList(ViewBag.telefonesTipo, "Id", "Nome", telefone?.TelefoneTipoId),
                    new { @class = "form-control", disabled = "disabled" })
                </div>
            </div>
        </div>
        <div style="width: 80px;">
            <dt class="col-sm-2">
                DDD
            </dt>
            <dd class="col-sm-10">
                @telefone?.DDD
            </dd>
        </div>
        <div style="flex: 1px;">
            <dt class="col-sm-2">
                Número
            </dt>
            <dd class="col-sm-10">
                @telefone?.Numero
            </dd>
        </div>
        <dt class="col-sm-2">
            Criado Em
        </dt>
        <dd class="col-sm-10">
            @Model.CriadoEm.ToString("dd/MM/yyyy")
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>
