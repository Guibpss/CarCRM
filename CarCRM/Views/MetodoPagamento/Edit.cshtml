@model CarCRM.ViewModels.MetodoPagamentoViewModel

@{
    ViewData["Title"] = "Edit";
}

<style>
    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>

<div class="container py-5">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-credit-card"></i>
                Editar Método de Pagamento
            </h2>

            <small class="text-muted">
                Edição dos dados do método de pagamento
            </small>
        </div>

        <div>
            <button type="submit" form="MetodoPagamentoEditar" class="btn btn-success">
                <i class="fa-solid fa-floppy-disk"></i>
                Salvar
            </button>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-x"></i>
                Cancelar
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-credit-card"></i>
                </div>

                Dados do Método de Pagamento

            </div>
        </div>

        <div class="card-body">

            <form asp-action="Edit" id="MetodoPagamentoEditar">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="row g-4">

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Nome</label>
                            <input name="Nome" value="@Model.Nome" class="form-control" />
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group form-check">
                            <label class="info-label">Ativo</label>
                            <input name="ativo" type="checkbox" value="true" class="form-check-input" @(Model.Ativo ? "Checked" : "") />
                        </div>
                    </div>

                </div>
            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
