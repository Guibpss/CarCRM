@model IEnumerable<CarCRM.ViewModels.VeiculoViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Veiculos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary"> Novo <i class="bi bi-plus-lg"></i></a>
</p>
<table id="veiculoListaId" class="table table-striped js-datatable">
    <thead>
        <tr>
            <th>Cor</th>
            <th>Km</th>
            <th>Placa</th>
            <th>Combustivel</th>
            <th>Motorização</th>
            <th>Ano Fabricação</th>
            <th>Ano Modelo</th>
            <th>Tipo</th>
            <th>Marca</th>
            <th class="no-sort" data-priority="1">Ações</th>
        </tr>    
    </thead>
    <tfoot>
        <tr>
            <th>Cor</th>
            <th>Km</th>
            <th>Placa</th>
            <th>Combustivel</th>
            <th>Motorização</th>
            <th>Ano Fabricação</th>
            <th>Ano Modelo</th>
            <th>Tipo</th>
            <th>Marca</th>
            <th class="no-sort" data-priority="1"></th>
        </tr>
    </tfoot>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.VeiculoCor?.Nome
            </td>
            <td>
                @item.KilometragemAtual
            </td>
            <td>
                @item.Placa
            </td>
            <td>
                @item.VeiculoCombustivel?.Nome
            </td>
            <td>
                @item.VeiculoMotorizacao?.Nome
            </td>
            <td>
                @item.AnoFabricacao
            </td>
            <td>
                @item.AnoModelo
            </td>
            <td>
                @item.VeiculoTipo?.Nome
            </td>
            <td>
                @item.VeiculoMarca?.Nome
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                    <i class="bi bi-pencil-square"></i></a>
                <a asp-action="Details" asp-route-id="@item.Id" title="Detalhes">
                    <i class="bi bi-eye"></i></a>
                <a asp-action="Delete" asp-route-id="@item.Id" title="Excluir">
                    <i class="bi bi-trash"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>