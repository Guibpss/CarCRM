@model CarCRM.ViewModels.VeiculoViewModel

@{
    ViewData["Title"] = "Create";
}

<style>
    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>
<div class="container py-5">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-car"></i>
                Cadastrar Veículo
            </h2>

            <small class="text-muted">
                Criação dos dados cadastrais
            </small>
        </div>

        <div>

            <button type="submit" form="VeiculoCreate" class="btn btn-success">
                <i class="fa-solid fa-plus"></i>
                Criar
            </button>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar
            </a>

        </div>
    </div>
    <div class="card mb-4">
        <div class="card-header">
            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-car"></i>
                </div>

                Dados do Veiculo

            </div>
        </div>

        <div class="card-body">

            <form asp-action="Create" id="VeiculoCreate">
                <div class="row g-4">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Placa</label>
                            <input name="placa" class="form-control" />
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Renavam</label>
                            <input name="renavam" class="form-control" />
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Marca</label>
                            @Html.DropDownList("veiculoMarcaId",
                                    new SelectList(ViewBag.veiculosMarca, "Id", "Nome"),
                                    "Selecione a Marca",
                                    new { @class = "form-select", id = "marcaSelect" })
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">
                            <label class="info-label">Modelo</label>
                            <select name="veiculoModeloId" id="modeloSelect" class="form-select">
                                <option value="">Selecione a marca primeiro</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="info-label">Versão</label>
                            <select name="veiculoVersaoId" id="versaoSelect" class="form-control">
                                <option value="">Selecione o modelo primeiro</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="info-label">Cor</label>
                            @Html.DropDownList("veiculoCorId",
                                    new SelectList(ViewBag.veiculosCor, "Id", "Nome"),
                                    new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="info-label">Km</label>
                            <input name="kilometragemAtual" class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="info-label">Combustível</label>
                            @Html.DropDownList("VeiculoCombustivelId",
                                    new SelectList(ViewBag.veiculosCombustivel, "Id", "Nome"),
                                    new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="info-label">Motorização</label>
                            @Html.DropDownList("VeiculoMotorizacaoId",
                                    new SelectList(ViewBag.veiculosMotorizacao, "Id", "Nome"),
                                    new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="info-label">Transmissão</label>
                            @Html.DropDownList("veiculoTransmissaoId",
                                    new SelectList(ViewBag.veiculosTransmissao, "Id", "Nome"),
                                    "Selecione a Transmissão",
                                    new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="info-label">Ano Fabricação</label>
                            <input name="anoFabricacao" type="number" min="1900" max="2100" class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="info-label">Ano Modelo</label>
                            <input name="anoModelo" type="number" min="1900" max="2100" class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="info-label">Tipo</label>
                            @Html.DropDownList("veiculoTipoId",
                                    new SelectList(ViewBag.veiculosTipo, "Id", "Nome"),
                                    "Selecione o Tipo",
                                    new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        $(document).ready(function() {
            $("#marcaSelect").change(function() {
                var marcaId = $(this).val();

                
                $("#modeloSelect").empty();
                $("#modeloSelect").append('<option value="">Carregando...</option>');

                if (marcaId) {
                    $.getJSON('@Url.Action("ModelosPorMarca", "Veiculos")', { marcaId: marcaId }, function(modelos) {
                        $("#modeloSelect").empty();
                        $("#modeloSelect").append('<option value="">Selecione o modelo</option>');

                        $.each(modelos, function(i, modelo) {
                            $("#modeloSelect").append('<option value="' + modelo.id + '">' + modelo.nome + '</option>'
                            );
                        });
                    });
                } else {
                    $("#modeloSelect").empty();
                    $("#modeloSelect").append('<option value="">Selecione a marca primeiro</option>');
                }

            });

            $("#modeloSelect").change(function() {
                var modeloId = $(this).val();

                $("#versaoSelect").empty();
                $("#versaoSelect").append('<option value="">Carregando...</option>');

                if (modeloId) {

                    $.getJSON('@Url.Action("VersaoPorModelos", "Veiculos")', { modeloId: modeloId }, function(versao) {

                        $("#versaoSelect").empty();
                        $("#versaoSelect").append('<option value="">Selecione a versão</option>');

                        $.each(versao, function(i, versao) {
                            $("#versaoSelect").append('<option value="' + versao.id + '">' + versao.nome + '</option>'
                            );
                        });
                    });
                } else {
                    $("#modeloSelect").empty();
                    $("#modeloSelect").append('<option value="">Selecione o modelo primeiro</option>');
                }

            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
