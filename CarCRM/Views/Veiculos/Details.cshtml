@model CarCRM.ViewModels.VeiculoViewModel

@{
    ViewData["Title"] = "Details";
}

<style>
    .carousel {
        margin: 2rem 10px;
    }

    .carousel-inner {
        width: 74%;
        margin: auto;
    }

    .carousel-item {
        width: 100%;
        height: 400px;
        background-size: cover;
        background-position: center;
    }

    .img1 {
        background-image: url("https://images.unsplash.com/photo-1426604966848-d7adac402bff?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
    }

    .img2 {
        background-image: url("https://images.unsplash.com/photo-1524684463181-5857e5b6f856?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
    }

    .img3 {
        background-image: url("https://plus.unsplash.com/premium_photo-1676385777209-1d435cc69c5a?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
    }

    .carousel-indicators {
        bottom: -3rem;
    }

        .carousel-indicators button {
            background-color: black !important;
            border-radius: 50%;
            width: 0.5rem !important;
            height: 0.5rem !important;
            display: block;
        }

    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>
<section class="car">

    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="false">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active img1">
            </div>
            <div class="carousel-item img2">
            </div>
            <div class="carousel-item img3">
            </div>
        </div>

        <button class="carousel-control-prev  text-dark display-6" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <i class="bi bi-arrow-left-circle"></i>
        </button>
        <button class="carousel-control-next text-dark display-6" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <i class="bi bi-arrow-right-circle"></i>
        </button>
    </div>

</section>

<div class="container py-4">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-car"></i>
                Visualizar Veículo
            </h2>

            <small class="text-muted">
                Visualização dos dados cadastrais
            </small>
        </div>
        <div>

            <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model?.Id">
                <i class="fa-solid fa-pencil"></i>
                Editar
            </a>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar
            </a>

        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-car"></i>
                </div>

                Dados do Veiculo

            </div>
        </div>

        <div class="card-body">

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="info-label">Placa</div>
                    <div class="info-value">@Model.Placa</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Renavam</div>
                    <div class="info-value">@Model.Renavam</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Marca</div>
                    <div class="info-value">@Model.VeiculoMarca.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Modelo</div>
                    <div class="info-value">@Model.VeiculoModelo.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Versão</div>
                    <div class="info-value">@Model.VeiculoVersao.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Cor</div>
                    <div class="info-value">@Model.VeiculoCor.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">KM</div>
                    <div class="info-value">@Model.KilometragemAtual</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Combustível</div>
                    <div class="info-value">@Model.VeiculoCombustivel.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Motorização</div>
                    <div class="info-value">@Model.VeiculoMotorizacao.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Transmissão</div>
                    <div class="info-value">@Model.VeiculoTransmissao?.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Ano Fabricação</div>
                    <div class="info-value">@Model.AnoFabricacao</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Ano Modelo</div>
                    <div class="info-value">@Model.AnoModelo</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Tipo</div>
                    <div class="info-value">@Model.VeiculoTipo.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Criado Em</div>
                    <div class="info-value">@Model.CriadoEm.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Excluido</div>
                    <div class="info-value"> @(Model.Excluido ? "Sim" : "Não")</div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                <i class="fa-solid fa-file-invoice-dollar text-primary"></i>
                Compras
            </h2>

            <small class="text-muted">
                Gerencie todas as compras cadastradas.
            </small>

        </div>

        @if (Model.Compra != null)
        {
            <div>
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#compraModal">
                    <i class="fa-solid fa-plus"></i>
                    Adicionar Compra
                </button>
            </div>
        }

       
    </div>

    <div class="card shadow-sm">

        <div class="card-header">

            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-handshake"></i>
                </div>

                Compras Cadastradas

            </div>

        </div>

        <div class="card-body">

            <table id="compraListaId" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Vendedor</th>
                        <th>Valor</th>
                        <th>Desconto</th>
                        <th>Valor Final</th>
                        <th>Status</th>
                        <th class="text-center no-sort" data-priority="1">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>
                            <span class="fw-semibold">
                                @Model.Compra?.DataCompra.ToString("dd/MM/yyyy")
                            </span>
                        </td>

                        <td>
                            @Model.Compra?.Vendedor?.Nome
                        </td>

                        <td>
                            R$ @String.Format("{0:N2}", @Model.Compra?.ValorCompra)
                        </td>

                        <td>
                            R$ @String.Format("{0:N2}", @Model.Compra?.Desconto)
                        </td>

                        <td>
                            <span class="fw-semibold">
                                R$ @String.Format("{0:N2}", @Model.Compra?.ValorFinal)
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-primary">
                                @Model.Compra?.StatusCompra?.Nome
                            </span>
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1 flex-nowrap">

                                <a href="#"
                                   class="btn btn-outline-warning btn-sm btn-editar-compra"
                                   data-bs-toggle="modal-edit-compra"
                                   data-bs-target="#compraModalEdit"
                                   data-id="@Model?.Compra?.Id"
                                   title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm btn-excluir-compra"
                                        data-id="@Model?.Compra?.Id"
                                        data-bs-toggle="modal"
                                        data-bs-target="#compraModalDelete"
                                        title="Excluir">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>

                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="compraModal" tabindex="-1" aria-labelledby="compraModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="compraModalLabel">Adicionar Compra</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Create" id="CompraCreate">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Data da Compra</label>
                                <input name="DataCompra" id="DataCompra" type="date" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Vendedor</label>
                                @Html.DropDownList("VendedorId",
                                      new SelectList(ViewBag.vendedores, "Id", "Nome"),
                                        "Selecione",
                                      new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Status</label>
                                @Html.DropDownList("StatusCompraId",
                                      new SelectList(ViewBag.statuscompras, "Id", "Nome"),
                                        "Selecione",
                                      new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Valor da Compra</label>
                                <input name="ValorCompra" id="ValorCompra" type="text" inputmode="decimal"
                                       placeholder="Ex.: 15.000,50" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Desconto</label>
                                <input name="Desconto" id="Desconto" type="text" inputmode="decimal"
                                       placeholder="Ex.: 0,00" value="0,00" class="form-control" required />
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="adicionarCompra()">Adicionar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compraModalEdit" tabindex="-1" aria-labelledby="compraModalLabelEdit" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="compraModalLabelEdit">Editar Compra</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="card-body">

                <form asp-action="Edit" id="CompraEditar">
                    <input type="hidden" id="CompraEdit_Id" />

                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Data da Compra</label>
                                <input name="DataCompra" id="CompraEdit_Data" type="date" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="info-label">Vendedor</label>
                                @Html.DropDownList("edit_VendedorId",
                                        new SelectList(ViewBag.vendedores, "Id", "Nome"),
                                        "Selecione",
                                        new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="info-label">Status</label>
                                @Html.DropDownList("edit_StatusCompraId",
                                        new SelectList(ViewBag.statuscompras, "Id", "Nome"),
                                        "Selecione",
                                        new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Valor da Compra</label>
                                <input name="ValorCompra" id="Edit_ValorCompra" type="text" inputmode="decimal"
                                       placeholder="Ex.: 15.000,50" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Desconto</label>
                                <input name="Desconto" id="Edit_Desconto" type="text" inputmode="decimal"
                                       placeholder="Ex.: 0,00" value="0,00" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="editarCompra()">Salvar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compraModalDelete" tabindex="-1" aria-labelledby="compraModalLabelDelete" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="compraModalLabelDelete">Confirmar Exclusão?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="text-center">

                    <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 45px;">
                    </i>

                    <h5 class="mt-3">
                        Tem certeza que deseja excluir esta compra?
                    </h5>

                    <p class="text-muted mb-0">
                        Essa ação não poderá ser desfeita!
                    </p>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>

                <form id="compraDeleteForm" asp-action="ExcluirCompra" method="post">
                    <input type="hidden" id="compraDeleteId" name="id" />
                    <input type="hidden" name="veiculoId" value="@Model.Id" />

                    <button type="submit" class="btn btn-danger" name="compra_delete" id="compraDeleteButton">
                        <i class="fa-solid fa-trash-can"></i>
                        Excluir
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>



<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                <i class="fa-solid fa-tags text-primary"></i>
                Vendas
            </h2>

            <small class="text-muted">
                Gerencie todas as vendas cadastradas.
            </small>

        </div>

        @if (Model.Compra != null)
        {
            <div>
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#vendaModal">
                    <i class="fa-solid fa-plus"></i>
                    Adicionar Venda
                </button>
            </div>
        }

       
    </div>

    <div class="card shadow-sm">

        <div class="card-header">

            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-cash-register"></i>
                </div>

                Vendas Cadastradas

            </div>

        </div>

        <div class="card-body">

            <table id="vendaListaId" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Cliente</th>
                        <th>Valor</th>
                        <th>Desconto</th>
                        <th>Valor Final</th>
                        <th>Status</th>
                        <th class="text-center no-sort" data-priority="1">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>
                            <span class="fw-semibold">
                                @Model.Venda.DataVenda.ToString("dd/MM/yyyy")
                            </span>
                        </td>

                        <td>
                            @Model.Venda.Cliente?.Pessoa?.Nome
                        </td>

                        <td>
                            R$ @String.Format("{0:N2}", Model.Venda.ValorVenda)
                        </td>

                        <td>
                            R$ @String.Format("{0:N2}", Model.Venda.Desconto)
                        </td>

                        <td>
                            <span class="fw-semibold">
                                R$ @String.Format("{0:N2}", Model.Venda.ValorFinal)
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-primary">
                                @Model.Venda.StatusVenda?.Nome
                            </span>
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1 flex-nowrap">

                                <a href="#"
                                   class="btn btn-outline-warning btn-sm btn-editar-venda"
                                   data-bs-toggle="modal-edit-venda"
                                   data-bs-target="#vendaModalEdit"
                                   data-id="@Model.Venda.Id"
                                   title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm btn-excluir-venda"
                                        data-id="@Model.Venda.Id"
                                        data-bs-toggle="modal"
                                        data-bs-target="#vendaModalDelete"
                                        title="Excluir">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>

                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="vendaModal" tabindex="-1" aria-labelledby="vendaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="vendaModalLabel">Adicionar Venda</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Create" id="VendaCreate">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Data da Venda</label>
                                <input name="DataVenda" id="DataVenda" type="date" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Cliente</label>
                                @Html.DropDownList("ClienteId",
                                      (List<SelectListItem>)ViewBag.clientes,
                                        "Selecione",
                                      new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Status</label>
                                @Html.DropDownList("StatusVendaId",
                                      new SelectList(ViewBag.statusvendas, "Id", "Nome"),
                                        "Selecione",
                                      new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Valor da Venda</label>
                                <input name="ValorVenda" id="ValorVenda" type="text" inputmode="decimal"
                                       placeholder="Ex.: 15.000,50" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Desconto</label>
                                <input name="Desconto" id="DescontoVenda" type="text" inputmode="decimal"
                                       placeholder="Ex.: 0,00" value="0,00" class="form-control" required />
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="adicionarVenda()">Adicionar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="vendaModalEdit" tabindex="-1" aria-labelledby="vendaModalLabelEdit" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="vendaModalLabelEdit">Editar Venda</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <form asp-action="Edit" id="VendaEditar">
                    <input type="hidden" id="VendaEdit_Id" />

                    <div class="row g-4">

                        <div class="col-lg-4">
                            <div class="form-group">
