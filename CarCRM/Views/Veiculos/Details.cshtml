            <div class="modal-body">
                <div class="text-center">

                    <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 45px;">
                    </i>

                    <h5 class="mt-3">
                        Tem certeza que deseja excluir esta venda?
                    </h5>

                    <p class="text-muted mb-0">
                        Essa ação não poderá ser desfeita!
                    </p>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>

                <form id="vendaDeleteForm" asp-action="ExcluirVenda" method="post">
                    <input type="hidden" id="vendaDeleteId" name="id" />
                    <input type="hidden" name="veiculoId" value="@Model.Id" />

                    <button type="submit" class="btn btn-danger" name="venda_delete" id="vendaDeleteButton">
                        <i class="fa-solid fa-trash-can"></i>
                        Excluir
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>


