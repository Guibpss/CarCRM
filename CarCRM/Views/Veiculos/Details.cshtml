<div class="container-fluid py-5">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                <i class="fa-solid fa-tags text-primary"></i>
                Venda
            </h2>

            <small class="text-muted">
                Gerencie a venda cadastrada.
            </small>

        </div>

        <div class="d-flex gap-2">
            @if (Model.Venda == null || Model.Venda.Id == 0)
            {
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#vendaModal">
                    <i class="fa-solid fa-plus"></i>
                    Adicionar Venda
                </button>
            }
            else
            {
                <a href="#" class="btn btn-warning btn-editar-venda" data-id="@Model.Venda.Id">
                    <i class="fa-solid fa-pencil"></i> Editar
                </a>
                <button type="button" class="btn btn-danger btn-excluir-venda"
                        data-id="@Model.Venda.Id" data-bs-toggle="modal"
                        data-bs-target="#vendaModalDelete">
                    <i class="fa-solid fa-trash-can"></i> Excluir
                </button>

            }
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">

            @* <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-cash-register"></i>
                </div>

                Venda Cadastrada

            </div> *@

        </div>

        <div class="card-body">
            @if (Model.Venda == null || Model.Venda.Id == 0)
            {
                <p class="text-muted mb-0">Nenhuma venda cadastrada para este veículo.</p>
            }
            else
            {

                <div class="row g-4">

                    <div class="col-md-3">
                        <div class="info-label">Data da Venda</div>
                        <div class="info-value">@Model.Venda.DataVenda.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Cliente</div>
                        <div class="info-value">@Model.Venda.Cliente?.Pessoa?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Status</div>
                        <div class="info-value">@Model.Venda.StatusVenda?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor da Venda</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.Venda.ValorVenda)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Desconto</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.Venda.Desconto)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor Final</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.Venda.ValorFinal)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Criado Em</div>
                        <div class="info-value">@Model.Venda.CriadoEm.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Excluido</div>
                        <div class="info-value">@(Model.Venda.Excluido ? "Sim" : "Não")</div>
                    </div>

                </div>
            }
        </div>

        <div class="container-fluid py-5">
            @if (Model.Venda == null || Model.Venda.Id == 0)
            {
                <p class="text-muted mb-0"></p>
            }
            else
            {

                <div class="d-flex justify-content-end align-items-center mb-4">

                    @* <div>

                        <h6 class="">
                            <i class="fa-solid fa-money-bill-wave text-primary"></i>
                            Pagamentos da Venda
                        </h6>

                        <small class="text-muted">
                            Gerencie todos os pagamentos para esta venda.
                        </small>

                    </div> *@
                    <div>
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#pagVendaModal">
                            <i class="fa-solid fa-plus"></i>
                            Adicionar Pagamento
                        </button>
                    </div>

                </div>

                <div class="card shadow-sm">

                    <div class="card-header">

                        <div class="section-title">

                            <div class="icon-box">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>

                            Pagamentos Cadastrados

                        </div>

                    </div>

                    <div class="card-body">

                        <table id="pagVendaListaId" class="table table-hover align-middle js-datatable">
                            <thead class="table-light">
                                <tr>
                                    <th>Valor</th>
                                    <th>Parcelas</th>
                                    <th>Vencimento</th>
                                    <th>Pagamento</th>
                                    <th>Método</th>
                                    <th>Status</th>
                                    <th class="text-center no-sort" data-priority="1">Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.PagamentosVenda)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">
                                                R$ @String.Format("{0:N2}", item.Valor)
                                            </span>
                                        </td>

                                        <td>
                                            @item.Parcelas
                                        </td>

                                        <td>
                                            @item.DataVencimento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.DataPagamento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.MetodoPagamento?.Nome
                                        </td>

                                        <td>
                                            @if (item.StatusPagamentoId == 1)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>

                                            }
                                            else if (item.StatusPagamentoId == 2)
                                            {
                                                <span class="badge bg-primary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 3)
                                            {
                                                <span class="badge bg-warning">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 4)
                                            {
                                                <span class="badge bg-secondary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 5)
                                            {
                                                <span class="badge bg-info">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 7)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 9)
                                            {
                                                <span class="badge bg-danger">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1 flex-nowrap">

                                                <a href="#"
                                                class="btn btn-outline-warning btn-sm btn-editar-pagamentovenda"
                                                data-bs-toggle="modal-edit-pagamento"
                                                data-bs-target="#pagVendaModalEdit"
                                                data-id="@item.Id"
                                                title="Editar">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>

                                                <button type="button"
                                                class="btn btn-outline-danger btn-sm btn-excluir-pagamentovenda"
                                                data-id="@item.Id"
                                                data-bs-toggle="modal"
                                                data-bs-target="#pagVendaModalDelete"
                                                title="Excluir">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                    </table>

                </div>

            </div>
            }
        </div>

    </div>

</div>


