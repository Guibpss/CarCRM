@section Scripts {
    <script>
        var ID_PAGO = 1;

        function alternarDataPagamento() {
            var pago = $("#StatusPagamentoId").val() == ID_PAGO;
            $("#campoDataPagamento").toggleClass('d-none', !pago);
            $("#DataPagamento").prop('disabled', !pago);
        }

        function alternarDataPagamentoEdit() {
            var pago = $("#edit_StatusPagamentoId").val() == ID_PAGO;
            $("#edit_campoDataPagamento").toggleClass('d-none', !pago);
            $("#edit_DataPagamento").prop('disabled', !pago);
        }

        $(document).ready(function() {
            $('#Valor').mask('#.##0,00', { reverse: true });
            $('#edit_Valor').mask('#.##0,00', { reverse: true });
            $('#ValorCompra, #Desconto, #Edit_ValorCompra, #Edit_Desconto').mask('#.##0,00', { reverse: true });
            $('#ValorVenda, #DescontoVenda, #Edit_ValorVenda, #Edit_DescontoVenda').mask('#.##0,00', { reverse: true });

            alternarDataPagamento();
            $('#StatusPagamentoId').on('change', alternarDataPagamento);
            $('#edit_StatusPagamentoId').on('change', alternarDataPagamentoEdit);

            $(document).on("click", ".btn-editar-pagamento", function() {
                var idPagamento = $(this).attr('data-id');
                editarPagamentoGet(idPagamento);
            });

            $(document).on("click", ".btn-editar-compra", function() {
                var idCompra = $(this).attr('data-id');
                editarCompraGet(idCompra);
            });

            $(document).on("click", ".btn-editar-venda", function() {
                var idVenda = $(this).attr('data-id');
                editarVendaGet(idVenda);
            });

            $(document).on("click", ".btn-excluir-pagamento", function() {
                var idPagamento = $(this).attr('data-id');
                $('#pagamentoDeleteId').val(idPagamento);
            });

            $(document).on("click", ".btn-excluir-compra", function() {
                var idCompra = $(this).attr('data-id');
                $('#compraDeleteId').val(idCompra);
            });

            $(document).on("click", ".btn-excluir-venda", function() {
                var idVenda = $(this).attr('data-id');
                $('#vendaDeleteId').val(idVenda);
            });

          
        });

        function adicionarPagamento() {
            var pagamento =
            {
                VeiculoId: '@Model.Id',
                Valor: $("#Valor").val(),
                Parcelas: $("#Parcelas").val(),
                DataVencimento: $("#DataVencimento").val(),
                StatusPagamentoId: $("#StatusPagamentoId").val(),
                MetodoPagamentoId: $("#MetodoPagamentoId").val()
            };

            $.ajax({
                type: "POST",
                url: "/Veiculos/AdicionarPagamento",
                data: pagamento,
                success: function(retorno) {

                    if (retorno.Sucesso) {
                        // alert(retorno.Mensagem);

                        $("#Valor").val('');
                        $("#pagamentoModal").modal('hide');
                        location.reload();
                    }
                    else {
                        alert("Erro: " + retorno.Mensagem);
                    }
                },
                error: function(res) {
                    console.log(res);
                }
            });

        }

        function adicionarCompra() {
            var compra =
            {
                VeiculoId: '@Model.Id',
                DataCompra: $("#DataCompra").val(),
                VendedorId: $("#VendedorId").val(),
                StatusCompraId: $("#StatusCompraId").val(),
                ValorCompra: $("#ValorCompra").val(),
                Desconto: $("#Desconto").val()
            };

            $.ajax({
                type: "POST",
                url: "/Veiculos/AdicionarCompra",
                data: compra,
                success: function(retorno) {

                    if (retorno.Sucesso) {
                        $("#ValorCompra").val('');
                        $("#compraModal").modal('hide');
                        location.reload();
                    }
                    else {
                        alert("Erro: " + retorno.Mensagem);
                    }
                },
                error: function(res) {
                    console.log(res);
                }
            });

        }

        function editarPagamentoGet(id) {

            $.ajax({
                url: '/Veiculos/ConsultarPagamentoPorId/' + id,
                type: 'GET',
                contentType: 'application/json;charset=utf-8',
                datatype: 'json',
                success: function(response) {
                    if (response == null || response == undefined) {
                        alert('Não foi possivel ler os dados 1')
                    }
                    else {
                        $('#pagamentoModalEdit').modal('show');
                        $('#pagamentoModalLabelEdit').text('Atualizar Pagamento');
                        $('#edit_Id').val(response.Resultado.Id);
                        $('#edit_Valor').val(response.Resultado.Valor);
                        $('#edit_Parcelas').val(response.Resultado.Parcelas);
                        $('#edit_DataVencimento').val(response.Resultado.DataVencimento);
                        $('#edit_DataPagamento').val(response.Resultado.DataPagamento);
                        $('#edit_StatusPagamentoId').val(response.Resultado.StatusPagamentoId);
                        $('#edit_MetodoPagamentoId').val(response.Resultado.MetodoPagamentoId);
                    }
                },
                error: function() {
                    alert('Não foi possível ler os dados.')
                }
            });
        }

        function editarCompraGet(id) {

            $.ajax({
                url: '/Veiculos/ConsultarCompraPorId/' + id,
                type: 'GET',
                contentType: 'application/json;charset=utf-8',
                datatype: 'json',
                success: function(response) {
                    if (response == null || response == undefined) {
                        alert('Não foi possivel ler os dados 1')
                    }
                    else {
                        $('#compraModalEdit').modal('show');
                        $('#compraModalLabelEdit').text('Atualizar Compra');
                        $('#CompraEdit_Id').val(response.Resultado.Id);
                        $('#CompraEdit_Data').val(response.Resultado.DataCompra);
                        $('#edit_VendedorId').val(response.Resultado.VendedorId);
                        $('#edit_VeiculoId').val(response.Resultado.VeiculoId);
                        $('#edit_StatusCompraId').val(response.Resultado.StatusCompraId);
                        $('#Edit_ValorCompra').val(response.Resultado.ValorCompra);
                        $('#Edit_Desconto').val(response.Resultado.Desconto);
                    }
                },
                error: function() {
                    alert('Não foi possível ler os dados.')
                }
            });
        }


        function editarPagamento() {
            var pagamento =
            {
                Id: $("#edit_Id").val(),
                VeiculoId: '@Model.Id',
                Valor: $("#edit_Valor").val(),
                Parcelas: $("#edit_Parcelas").val(),
                DataVencimento: $("#edit_DataVencimento").val(),
                DataPagamento: $("#edit_DataPagamento").val(),
                StatusPagamentoId: $("#edit_StatusPagamentoId").val(),
                MetodoPagamentoId: $("#edit_MetodoPagamentoId").val()
            };

            $.ajax({
                type: "POST",
                url: "/Veiculos/EditarPagamento",
                data: pagamento,
                success: function(retorno) {

                    if (retorno.Sucesso) {
                        // alert(retorno.Mensagem);
                        $("#edit_Valor").val('');
                        $("#pagamentoModalEditar").modal('hide');
                        location.reload();
                    }
                    else {
                        alert("Erro: " + retorno.Mensagem);
                    }
                },
                error: function(res) {
                    console.log(res);
                }
            });

        }

        function editarCompra() {
            var compra =
            {
                Id: $("#CompraEdit_Id").val(),
                VeiculoId: '@Model.Id',
                DataCompra: $("#CompraEdit_Data").val(),
                VendedorId: $("#edit_VendedorId").val(),
                VeiculoId: $("#edit_VeiculoId").val(),
                StatusCompraId: $("#edit_StatusCompraId").val(),
                ValorCompra: $("#Edit_ValorCompra").val(),
                Desconto: $("#Edit_Desconto").val()
            };

            $.ajax({
                type: "POST",
                url: "/Veiculos/EditarCompra",
                data: compra,
                success: function(retorno) {

                    if (retorno.Sucesso) {
                        // alert(retorno.Mensagem);
                        $("#Edit_ValorCompra").val('');
                        $("#compraModalEdit").modal('hide');
                        location.reload();
                    }
                    else {
                        alert("Erro: " + retorno.Mensagem);
                    }
                },
                error: function(res) {
                    console.log(res);
                }
            });

        }


        function adicionarVenda() {
            var venda =
            {
                VeiculoId: '@Model.Id',
                DataVenda: $("#DataVenda").val(),
                ClienteId: $("#ClienteId").val(),
                StatusVendaId: $("#StatusVendaId").val(),
                ValorVenda: $("#ValorVenda").val(),
                Desconto: $("#DescontoVenda").val()
            };

            $.ajax({
                type: "POST",
                url: "/Veiculos/AdicionarVenda",
                data: venda,
                success: function(retorno) {

                    if (retorno.Sucesso) {
                        $("#ValorVenda").val('');
                        $("#vendaModal").modal('hide');
                        location.reload();
                    }
                    else {
                        alert("Erro: " + retorno.Mensagem);
                    }
                },
                error: function(res) {
                    console.log(res);
                }
            });

        }

        function editarVendaGet(id) {

            $.ajax({
                url: '/Veiculos/ConsultarVendaPorId/' + id,
                type: 'GET',
                contentType: 'application/json;charset=utf-8',
                datatype: 'json',
                success: function(response) {
                    if (response == null || response == undefined) {
                        alert('Não foi possivel ler os dados 1')
                    }
                    else {
                        $('#vendaModalEdit').modal('show');
                        $('#vendaModalLabelEdit').text('Atualizar Venda');
                        $('#VendaEdit_Id').val(response.Resultado.Id);
                        $('#VendaEdit_Data').val(response.Resultado.DataVenda);
                        $('#edit_ClienteId').val(response.Resultado.ClienteId);
                        $('#edit_StatusVendaId').val(response.Resultado.StatusVendaId);
                        $('#Edit_ValorVenda').val(response.Resultado.ValorVenda);
                        $('#Edit_DescontoVenda').val(response.Resultado.Desconto);
                    }
                },
                error: function() {
                    alert('Não foi possível ler os dados.')
                }
            });
        }

        function editarVenda() {
            var venda =
            {
                Id: $("#VendaEdit_Id").val(),
                VeiculoId: '@Model.Id',
                DataVenda: $("#VendaEdit_Data").val(),
                ClienteId: $("#edit_ClienteId").val(),
                StatusVendaId: $("#edit_StatusVendaId").val(),
                ValorVenda: $("#Edit_ValorVenda").val(),
                Desconto: $("#Edit_DescontoVenda").val()
            };

            $.ajax({
                type: "POST",
                url: "/Veiculos/EditarVenda",
                data: venda,
                success: function(retorno) {

                    if (retorno.Sucesso) {
                        $("#Edit_ValorVenda").val('');
                        $("#vendaModalEdit").modal('hide');
                        location.reload();
                    }
                    else {
                        alert("Erro: " + retorno.Mensagem);
                    }
                },
                error: function(res) {
                    console.log(res);
                }
            });

        }
    </script>
}