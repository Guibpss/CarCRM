@model CarCRM.ViewModels.VeiculoViewModel

@{
    ViewData["Title"] = "Details";
}

<style>
    .carousel {
        margin: 2rem 10px;
    }

    .carousel-inner {
        width: 74%;
        margin: auto;
    }

    .carousel-item {
        width: 100%;
        height: 400px;
        background-size: cover;
        background-position: center;
    }

    .img1 {
        background-image: url("https://images.unsplash.com/photo-1426604966848-d7adac402bff?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
    }

    .img2 {
        background-image: url("https://images.unsplash.com/photo-1524684463181-5857e5b6f856?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
    }

    .img3 {
        background-image: url("https://plus.unsplash.com/premium_photo-1676385777209-1d435cc69c5a?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
    }

    .carousel-indicators {
        bottom: -3rem;
    }

        .carousel-indicators button {
            background-color: black !important;
            border-radius: 50%;
            width: 0.5rem !important;
            height: 0.5rem !important;
            display: block;
        }

    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>
<section class="car">

    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="false">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active img1">
            </div>
            <div class="carousel-item img2">
            </div>
            <div class="carousel-item img3">
            </div>
        </div>

        <button class="carousel-control-prev  text-dark display-6" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <i class="bi bi-arrow-left-circle"></i>
        </button>
        <button class="carousel-control-next text-dark display-6" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <i class="bi bi-arrow-right-circle"></i>
        </button>
    </div>

</section>

<div class="container py-4">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-car"></i>
                Visualizar Veículo
            </h2>

            <small class="text-muted">
                Visualização dos dados cadastrais
            </small>
        </div>
        <div>

            <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model?.Id">
                <i class="fa-solid fa-pencil"></i>
                Editar
            </a>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar
            </a>

        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-car"></i>
                </div>

                Dados do Veiculo

            </div>
        </div>

        <div class="card-body">

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="info-label">Placa</div>
                    <div class="info-value">@Model.Placa</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Renavam</div>
                    <div class="info-value">@Model.Renavam</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Marca</div>
                    <div class="info-value">@Model.VeiculoMarca.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Modelo</div>
                    <div class="info-value">@Model.VeiculoModelo.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Versão</div>
                    <div class="info-value">@Model.VeiculoVersao.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Cor</div>
                    <div class="info-value">@Model.VeiculoCor.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">KM</div>
                    <div class="info-value">@Model.KilometragemAtual</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Combustível</div>
                    <div class="info-value">@Model.VeiculoCombustivel.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Motorização</div>
                    <div class="info-value">@Model.VeiculoMotorizacao.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Transmissão</div>
                    <div class="info-value">@Model.VeiculoTransmissao?.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Ano Fabricação</div>
                    <div class="info-value">@Model.AnoFabricacao</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Ano Modelo</div>
                    <div class="info-value">@Model.AnoModelo</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Tipo</div>
                    <div class="info-value">@Model.VeiculoTipo.Nome</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Criado Em</div>
                    <div class="info-value">@Model.CriadoEm.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Excluido</div>
                    <div class="info-value"> @(Model.Excluido ? "Sim" : "Não")</div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                <i class="fa-solid fa-file-invoice-dollar text-primary"></i>
                Compra
            </h2>

            <small class="text-muted">
                Gerencie a compra cadastrada.
            </small>

        </div>

        <div class="d-flex gap-2">
            @if (Model.Compra == null || Model.Compra.Id == 0)
            {
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#compraModal">
                    <i class="fa-solid fa-plus"></i> Adicionar Compra
                </button>
            }
            else
            {
                <a href="#" class="btn btn-warning btn-editar-compra" data-id="@Model.Compra.Id">
                    <i class="fa-solid fa-pencil"></i> Editar
                </a>
                <button type="button" class="btn btn-danger btn-excluir-compra"
                        data-id="@Model.Compra.Id" data-bs-toggle="modal"
                        data-bs-target="#compraModalDelete">
                    <i class="fa-solid fa-trash-can"></i> Excluir
                </button>
            }
        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header">

            @* <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-handshake"></i>
                </div>

                Compra Cadastrada

            </div> *@

        </div>

        <div class="card-body">
            @if (Model.Compra == null || Model.Compra.Id == 0)
            {
                <p class="text-muted mb-0">Nenhuma compra cadastrada para este veículo.</p>
            }
            else
            {

                <div class="row g-4">

                    <div class="col-md-3">
                        <div class="info-label">Data da Compra</div>
                        <div class="info-value">@Model.Compra.DataCompra.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Vendedor</div>
                        <div class="info-value">@Model.Compra.Vendedor?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Status</div>
                        <div class="info-value">@Model.Compra.StatusCompra?.Nome</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor da Compra</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.Compra.ValorCompra)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Desconto</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.Compra.Desconto)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Valor Final</div>
                        <div class="info-value">R$ @String.Format("{0:N2}", Model.Compra.ValorFinal)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Criado Em</div>
                        <div class="info-value">@Model.Compra.CriadoEm.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="info-label">Excluido</div>
                        <div class="info-value">@(Model.Compra.Excluido ? "Sim" : "Não")</div>
                    </div>

                </div>
            }
        </div>

        <div class="container-fluid py-5">
            @if (Model.Compra == null || Model.Compra.Id == 0)
            {
                <p class="text-muted mb-0"></p>
            }
            else
            {

                <div class="d-flex justify-content-end align-items-center mb-4">

                    @* <div>

                        <h6 class="">
                            <i class="fa-solid fa-money-bill-wave text-primary"></i>
                            Pagamentos da Compra
                        </h6>

                        <small class="text-muted">
                            Gerencie todos os pagamentos para esta compra.
                        </small>

                    </div> *@
                    <div>
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#pagCompraModal">
                            <i class="fa-solid fa-plus"></i>
                            Adicionar Pagamento
                        </button>
                    </div>


                </div>

                <div class="card shadow-sm">

                    <div class="card-header">

                        <div class="section-title">

                            <div class="icon-box">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>

                            Pagamentos Cadastrados

                        </div>

                    </div>

                    <div class="card-body">

                        <table id="pagCompraListaId" class="table table-hover align-middle js-datatable">
                            <thead class="table-light">
                                <tr>
                                    <th>Valor</th>
                                    <th>Parcelas</th>
                                    <th>Vencimento</th>
                                    <th>Pagamento</th>
                                    <th>Método</th>
                                    <th>Status</th>
                                    <th class="text-center no-sort" data-priority="1">Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.PagamentosCompra)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">
                                                R$ @String.Format("{0:N2}", item.Valor)
                                            </span>
                                        </td>

                                        <td>
                                            @item.Parcelas
                                        </td>

                                        <td>
                                            @item.DataVencimento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.DataPagamento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @item.MetodoPagamento?.Nome
                                        </td>

                                        <td>
                                            @if (item.StatusPagamentoId == 1)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>

                                            }
                                            else if (item.StatusPagamentoId == 2)
                                            {
                                                <span class="badge bg-primary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 3)
                                            {
                                                <span class="badge bg-warning">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 4)
                                            {
                                                <span class="badge bg-secondary">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 5)
                                            {
                                                <span class="badge bg-info">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 7)
                                            {
                                                <span class="badge bg-success">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                            else if (item.StatusPagamentoId == 9)
                                            {
                                                <span class="badge bg-danger">
                                                    @item.StatusPagamento?.Nome
                                                </span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1 flex-nowrap">

                                                <a href="#"
                                                   class="btn btn-outline-warning btn-sm btn-editar-pagamentocompra"
                                                   data-bs-toggle="modal-edit-pagamento"
                                                   data-bs-target="#pagCompraModalEdit"
                                                   data-id="@item.Id"
                                                   title="Editar">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>

                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm btn-excluir-pagamentocompra"
                                                        data-id="@item.Id"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#pagCompraModalDelete"
                                                        title="Excluir">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                </div>
            }
        </div>

    </div>
</div>

<div class="modal fade" id="pagCompraModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Adicionar Pagamento da Compra</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="info-label">Valor</label>
                        <input id="pagCompra_Valor" type="text" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Parcelas</label>
                        <input id="pagCompra_Parcelas" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Data Vencimento</label>
                        <input id="pagCompra_DataVencimento" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none" id="pagCompra_campoDataPagamento">
                        <label class="info-label">Data Pagamento</label>
                        <input id="pagCompra_DataPagamento" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Método de Pagamento</label>
                        @Html.DropDownList("pagCompra_MetodoPagamentoId",
                            new SelectList(ViewBag.MetodoPagamento, "Id", "Nome"),
                            "Selecione", new { @class = "form-select" })
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Status</label>
                        @Html.DropDownList("pagCompra_StatusPagamentoId",
                            new SelectList(ViewBag.StatusPagamento, "Id", "Nome"),
                            "Selecione", new { @class = "form-select" })
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="adicionarPagamentoCompra()">Adicionar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pagCompraModalEdit" tabindex="-1" aria-labelledby="pagCompraModalLabelEdit" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="pagCompraModalLabelEdit">Editar Pagamento</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="card-body">

                <form asp-action="Edit" id="PagCompraEditar">
                    <input type="hidden" id="pagCompraEdit_Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="info-label">Valor</label>
                            <input name="Valor" id="pagCompraEdit_Valor" type="text" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="info-label">Parcelas</label>
                            <input name="Parcelas" id="pagCompraEdit_Parcelas" type="number" min="1" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="info-label">Data Vencimento</label>
                            <input name="DataVencimento" id="pagCompraEdit_DataVencimento" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 d-none" id="pagCompraEdit_campoDataPagamento">
                            <label class="info-label">Data Pagamento</label>
                            <input name="DataPagamento" id="pagCompraEdit_DataPagamento" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="info-label">Método de Pagamento</label>
                            @Html.DropDownList("pagCompraEdit_MetodoPagamentoId",
                                new SelectList(ViewBag.MetodoPagamento, "Id", "Nome"),
                                "Selecione", new { @class = "form-select" })
                        </div>
                        <div class="col-md-6">
                            <label class="info-label">Status</label>
                            @Html.DropDownList("pagCompraEdit_StatusPagamentoId",
                                new SelectList(ViewBag.StatusPagamento, "Id", "Nome"),
                                "Selecione", new { @class = "form-select" })
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="pagCompraEditarPagamento()">Salvar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pagCompraModalDelete" tabindex="-1" aria-labelledby="pagCompraModalLabelDelete" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="pagCompraModalLabelDelete">Confirmar Exclusão?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="text-center">

                    <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 45px;">
                    </i>

                    <h5 class="mt-3">
                        Tem certeza que deseja excluir este pagamento?
                    </h5>

                    <p class="text-muted mb-0">
                        Essa ação não poderá ser desfeita!
                    </p>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>

                <form id="pagCompraDeleteForm" asp-action="ExcluirPagamentoCompra" method="post">
                    <input type="hidden" id="pagCompraDeleteId" name="id" />
                    <input type="hidden" name="veiculoId" value="@Model.Id" />

                    <button type="submit" class="btn btn-danger" name="pagamento_delete" id="pagCompraDeleteButton">
                        <i class="fa-solid fa-trash-can"></i>
                        Excluir
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>

                        
<div class="modal fade" id="compraModal" tabindex="-1" aria-labelledby="compraModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="compraModalLabel">Adicionar Compra</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Create" id="CompraCreate">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Data da Compra</label>
                                <input name="DataCompra" id="DataCompra" type="date" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Vendedor</label>
                                @Html.DropDownList("VendedorId",
                                      new SelectList(ViewBag.vendedores, "Id", "Nome"),
                                        "Selecione",
                                      new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Status</label>
                                @Html.DropDownList("StatusCompraId",
                                      new SelectList(ViewBag.statuscompras, "Id", "Nome"),
                                        "Selecione",
                                      new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="info-label">Valor da Compra</label>
                                <input name="ValorCompra" id="ValorCompra" type="text" inputmode="decimal"
                                       placeholder="Ex.: 15.000,50" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-lg-4">
