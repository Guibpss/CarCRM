<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                <i class="fa-solid fa-money-bill-wave text-primary"></i>
                Pagamentos do Veículo
            </h2>

            <small class="text-muted">
                Gerencie todos os pagamentos para este veículo
            </small>

        </div>

        <div>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#pagamentoModal">
                <i class="fa-solid fa-plus"></i>
                Adicionar Pagamento
            </button>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">

            <div class="section-title">

                <div class="icon-box">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>

                Pagamentos Cadastrados

            </div>

        </div>

        <div class="card-body">

            <table id="pagamentoListaId" class="table table-hover align-middle js-datatable">
                <thead class="table-light">
                    <tr>
                        <th>Valor</th>
                        <th>Parcelas</th>
                        <th>Vencimento</th>
                        <th>Pagamento</th>
                        <th>Método</th>
                        <th>Status</th>
                        <th class="text-center no-sort" data-priority="1">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.PagamentosCompra)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">
                                    R$ @String.Format("{0:N2}", item.Valor)
                                </span>
                            </td>

                            <td>
                                @item.Parcelas
                            </td>

                            <td>
                                @item.DataVencimento.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.DataPagamento.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.MetodoPagamento?.Nome
                            </td>

                            <td>
                                @if (item.StatusPagamentoId == 1)
                                {
                                    <span class="badge bg-success">
                                        @item.StatusPagamento?.Nome
                                    </span>

                                }
                                else if (item.StatusPagamentoId == 2)
                                {
                                    <span class="badge bg-primary">
                                        @item.StatusPagamento?.Nome
                                    </span>
                                }
                                else if (item.StatusPagamentoId == 3)
                                {
                                    <span class="badge bg-warning">
                                        @item.StatusPagamento?.Nome
                                    </span>
                                }
                                else if (item.StatusPagamentoId == 4)
                                {
                                    <span class="badge bg-secondary">
                                        @item.StatusPagamento?.Nome
                                    </span>
                                }
                                else if (item.StatusPagamentoId == 5)
                                {
                                    <span class="badge bg-info">
                                        @item.StatusPagamento?.Nome
                                    </span>
                                }
                                else if (item.StatusPagamentoId == 7)
                                {
                                    <span class="badge bg-success">
                                        @item.StatusPagamento?.Nome
                                    </span>
                                }
                                else if (item.StatusPagamentoId == 9)
                                {
                                    <span class="badge bg-danger">
                                        @item.StatusPagamento?.Nome
                                    </span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1 flex-nowrap">

                                    <a href="#"
                                       class="btn btn-outline-warning btn-sm btn-editar-pagamento"
                                       data-bs-toggle="modal-edit-pagamento"
                                       data-bs-target="#pagamentoModalEdit"
                                       data-id="@item.Id"
                                       title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm btn-excluir-pagamento"
                                            data-id="@item.Id"
                                            data-bs-toggle="modal"
                                            data-bs-target="#pagamentoModalDelete"
                                            title="Excluir">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>

</div>


