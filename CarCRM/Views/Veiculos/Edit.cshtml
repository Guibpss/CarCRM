@model CarCRM.ViewModels.VeiculoViewModel

@{
    ViewData["Title"] = "Edit";
}
<style>
    .carousel {
        margin: 2rem 10px;
    }

    .carousel-inner {
        width: 74%;
        margin: auto;
    }

    .carousel-item {
        width: 100%;
        height: 400px;
        background-size: cover;
        background-position: center;

        display: flex;
        align-items: center;
        justify-content: center;

    }

    .carousel-item.active {
        display: flex !important;
}

    .carousel-item .btn {
    margin: 0;
}

    .carousel-indicators {
        bottom: -3rem;
    }

        .carousel-indicators button {
            background-color: black !important;
            border-radius: 50%;
            width: 0.5rem !important;
            height: 0.5rem !important;
            display: block;
        }

    .btn-add-image {
         cursor: pointer;
         font-size: 3rem;   
         color: #6c757d;
    }

    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
    }

    .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.07);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #ececec;
        padding: 20px 30px;
    }

    .card-body {
        padding: 30px;
    }

    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #9a9a9a;
        font-weight: 600;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: #2f3640;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: #0d6efd15;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #0d6efd;
        margin-right: 15px;
    }

    .section-title {
        display: flex;
        align-items: center;
        font-size: 20px;
        font-weight: 600;
    }

    .btn {
        border-radius: 10px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 14px;
    }
</style>

<section class="car">

    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="false">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active img1">
                <input type="file" id="customFile" name="file" hidden>

			    <label class="btn-add-image" for="customFile">
                    <i class="fa-solid fa-circle-plus"></i>

                </label>
            </div>
            <div class="carousel-item img2">
                <input type="file" id="customFile2" name="file2" hidden="">
			    <label class="btn-add-image" for="customFile2">
                    <i class="fa-solid fa-circle-plus"></i>
                </label>
            </div>
            <div class="carousel-item img3">
                <input type="file" id="customFile3" name="file3" hidden="">
			    <label class="btn-add-image" for="customFile3">
                    <i class="fa-solid fa-circle-plus"></i>
                </label>
            </div>
        </div>

        <button class="carousel-control-prev  text-dark display-6" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <i class="bi bi-arrow-left-circle"></i>
        </button>
        <button class="carousel-control-next text-dark display-6" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <i class="bi bi-arrow-right-circle"></i>
        </button>
    </div>

</section>

<div class="container py-5">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2 class="page-title">
                <i class="fa-solid fa-car"></i>
                Editar Veículo
            </h2>

            <small class="text-muted">
                Edição dos dados de veículo
            </small>
        </div>

        <div>
            <button type="submit" form="VeiculoEditar" class="btn btn-success">
                <i class="fa-solid fa-floppy-disk"></i>
                Salvar
            </button>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-x"></i>
                Cancelar
            </a>
        </div>
     </div>
        <div class="card mb-4">
            <div class="card-header">
                <div class="section-title">

                    <div class="icon-box">
                        <i class="fa-solid fa-car"></i>
                    </div>

                    Dados do Veiculo

                </div>
            </div>

            <div class="card-body">
                <form asp-action="Edit" id="VeiculoEditar">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }

                    <div class="row g-4">
                        <input type="hidden" asp-for="Id" />

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="Placa" class="info-label">Placa</label>
                                <input asp-for="Placa" class="form-control text-uppercase" maxlength="7" oninput="this.value = this.value.toUpperCase()" />
                                <span asp-validation-for="Placa" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="Renavam" class="info-label">Renavam</label>
                                <input asp-for="Renavam" class="form-control" maxlength="11" />
                                <span asp-validation-for="Renavam" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoMarcaId" class="info-label">Marca</label>
                                <select asp-for="VeiculoMarcaId" id="marcaSelect" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.veiculosMarca, "Id", "Nome"))">
                                    <option value="">Selecione a Marca</option>
                                </select>
                                <span asp-validation-for="VeiculoMarcaId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoModeloId" class="info-label">Modelo</label>
                                <select asp-for="VeiculoModeloId" id="modeloSelect" class="form-select">
                                    <option value="">Selecione a marca primeiro</option>
                                </select>
                                <span asp-validation-for="VeiculoModeloId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoVersaoId" class="info-label">Versão</label>
                                <select asp-for="VeiculoVersaoId" id="versaoSelect" class="form-select">
                                    <option value="">Selecione o modelo primeiro</option>
                                </select>
                                <span asp-validation-for="VeiculoVersaoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoCorId" class="info-label">Cor</label>
                                <select asp-for="VeiculoCorId" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.veiculosCor, "Id", "Nome"))">
                                    <option value="">Selecione a Cor</option>
                                </select>
                                <span asp-validation-for="VeiculoCorId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="KilometragemAtual" class="info-label">Km</label>
                                <input asp-for="KilometragemAtual" type="number" class="form-control" />
                                <span asp-validation-for="KilometragemAtual" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoCombustivelId" class="info-label">Combustível</label>
                                <select asp-for="VeiculoCombustivelId" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.veiculosCombustivel, "Id", "Nome"))">
                                    <option value="">Selecione o Combustível</option>
                                </select>
                                <span asp-validation-for="VeiculoCombustivelId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoMotorizacaoId" class="info-label">Motorização</label>
                                <select asp-for="VeiculoMotorizacaoId" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.veiculosMotorizacao, "Id", "Nome"))">
                                    <option value="">Selecione a Motorização</option>
                                </select>
                                <span asp-validation-for="VeiculoMotorizacaoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoTransmissaoId" class="info-label">Transmissão</label>
                                <select asp-for="VeiculoTransmissaoId" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.veiculosTransmissao, "Id", "Nome"))">
                                    <option value="">Selecione a Transmissão</option>
                                </select>
                                <span asp-validation-for="VeiculoTransmissaoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="AnoFabricacao" class="info-label">Ano Fabricação</label>
                                <input asp-for="AnoFabricacao" type="number" class="form-control" />
                                <span asp-validation-for="AnoFabricacao" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="AnoModelo" class="info-label">Ano Modelo</label>
                                <input asp-for="AnoModelo" type="number" class="form-control" />
                                <span asp-validation-for="AnoModelo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="VeiculoTipoId" class="info-label">Tipo</label>
                                <select asp-for="VeiculoTipoId" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.veiculosTipo, "Id", "Nome"))">
                                    <option value="">Selecione o Tipo</option>
                                </select>
                                <span asp-validation-for="VeiculoTipoId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

@section Scripts {
        <script>
                $(document).ready(function() {
                    var modeloAtual = '@Model.VeiculoModeloId';
                    var versaoAtual = '@Model.VeiculoVersaoId';

                    function carregarModelos(marcaId, selecionado) {
                        $("#modeloSelect").empty();
                        if (!marcaId) {
                            $("#modeloSelect").append('<option value="">Selecione a marca primeiro</option>');
                            return;
                        }
                        $.getJSON('@Url.Action("ModelosPorMarca", "Veiculos")', { marcaId: marcaId }, function(modelos) {
                            $("#modeloSelect").append('<option value="">Selecione o modelo</option>');
                            $.each(modelos, function(i, modelo) {
                                var sel = (modelo.id == selecionado) ? ' selected' : '';
                                $("#modeloSelect").append('<option value="' + modelo.id + '"' + sel + '>' + modelo.nome + '</option>');
                            });
                        });
                    }

                    function carregarVersoes(modeloId, selecionado) {
                        $("#versaoSelect").empty();
                        if (!modeloId) {
                            $("#versaoSelect").append('<option value="">Selecione o modelo primeiro</option>');
                            return;
                        }
                        $.getJSON('@Url.Action("VersaoPorModelos", "Veiculos")', { modeloId: modeloId }, function(versao) {
                            $("#versaoSelect").append('<option value="">Selecione o modelo</option>');
                            $.each(versao, function(i, versao) {
                                var sel = (versao.id == selecionado) ? ' selected' : '';
                                $("#versaoSelect").append('<option value="' + versao.id + '"' + sel + '>' + versao.nome + '</option>');
                            });
                        });
                    }


                    carregarModelos($("#marcaSelect").val(), modeloAtual);

                    carregarVersoes(modeloAtual, versaoAtual);

                    $("#marcaSelect").change(function() {
                        carregarModelos($(this).val(), null);
                    });

                    $("#modeloSelect").change(function() {
                        carregarVersoes($(this).val(), null);
                    });
                });


        </script>
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
}
